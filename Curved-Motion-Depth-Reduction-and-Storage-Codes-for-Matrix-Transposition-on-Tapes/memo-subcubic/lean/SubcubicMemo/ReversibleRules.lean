import MotionDepthCodes.MatchingForm

/-!
# Generating sets for reversible local rules

The matrix in the combinatorial proof records only the named supports. No
linear equations are assumed of the objects generated by the rules. Reuse
the original paper's chain sets and their counting/geometry lemmas.
-/

namespace SubcubicMemo

open Finset MotionDepthCodes
open scoped BigOperators

variable {V F : Type*} [Fintype V] [DecidableEq V] [Field F] [DecidableEq F]

/-- Finite derivation by the reversible rules of the rows centered in `W`.
Deleting vertices restricts a row's premises to the surviving vertices. -/
inductive Derivable (M : Matrix V V F) (W B : Finset V) : V → Prop
  | seed {x} : x ∈ B → Derivable M W B x
  | rule {v x} : v ∈ W → x ∈ insert v (recSet M v) ∩ W →
      (∀ y ∈ insert v (recSet M v) ∩ W, y ≠ x → Derivable M W B y) →
      Derivable M W B x

theorem Derivable.mono {M : Matrix V V F} {W B B' : Finset V}
    (hBB' : B ⊆ B') {x : V} (h : Derivable M W B x) : Derivable M W B' x := by
  induction h with
  | seed hx => exact .seed (hBB' hx)
  | rule hv hx _ ih => exact .rule hv hx ih

/-- Replace every seed by an already available derivation. -/
theorem Derivable.bind {M : Matrix V V F} {W B B' : Finset V}
    (hB : ∀ b ∈ B, Derivable M W B' b) {x : V} (h : Derivable M W B x) :
    Derivable M W B' x := by
  induction h with
  | seed hx => exact hB _ hx
  | rule hv hx _ ih => exact .rule hv hx ih

/-- Only omitted premises of actual surviving rows must be supplied. -/
theorem Derivable.lift_of_boundary {M : Matrix V V F} {W A B D : Finset V}
    (hAW : A ⊆ W) (hB : ∀ b ∈ B, Derivable M W D b)
    (hboundary : ∀ v ∈ A, ∀ y ∈ insert v (recSet M v) ∩ W,
      y ∉ A → Derivable M W D y)
    {x : V} (h : Derivable M A B x) : Derivable M W D x := by
  induction h with
  | seed hx => exact hB _ hx
  | @rule v x hv hx _ ih =>
    obtain ⟨hxr, hxA⟩ := mem_inter.mp hx
    refine .rule (hAW hv) (mem_inter.mpr ⟨hxr, hAW hxA⟩) ?_
    intro y hy hne
    by_cases hyA : y ∈ A
    · exact ih y (mem_inter.mpr ⟨(mem_inter.mp hy).1, hyA⟩) hne
    · exact hboundary v hv y hy hyA

/-- Lift a derivation on a smaller set, paying for the removed premises. -/
theorem Derivable.lift {M : Matrix V V F} {W A B D : Finset V}
    (hAW : A ⊆ W) (hB : ∀ b ∈ B, Derivable M W D b)
    (hrest : ∀ x ∈ W \ A, Derivable M W D x)
    {x : V} (h : Derivable M A B x) : Derivable M W D x :=
  h.lift_of_boundary hAW hB (fun _ _ y hy hyA =>
    hrest y (mem_sdiff.mpr ⟨(mem_inter.mp hy).2, hyA⟩))

def Generates (M : Matrix V V F) (W B : Finset V) : Prop :=
  B ⊆ W ∧ ∀ x ∈ W, Derivable M W B x

/-- Join generators of an already generated set and its complement. -/
theorem generates_union {M : Matrix V V F} {W A B D : Finset V}
    (hAW : A ⊆ W) (hBA : B ⊆ A)
    (hA : ∀ x ∈ A, Derivable M W B x) (hD : Generates M (W \ A) D) :
    Generates M W (B ∪ D) := by
  have hA' : ∀ x ∈ A, Derivable M W (B ∪ D) x :=
    fun x hx => (hA x hx).mono subset_union_left
  refine ⟨union_subset (hBA.trans hAW) (hD.1.trans sdiff_subset), ?_⟩
  intro x hx
  by_cases hxA : x ∈ A
  · exact hA' x hxA
  · apply (hD.2 x (mem_sdiff.mpr ⟨hx, hxA⟩)).lift sdiff_subset
    · exact fun b hb => .seed (mem_union_right B hb)
    · intro y hy
      have hy' : y ∈ W ∧ (y ∈ W → y ∈ A) := by
        simpa only [mem_sdiff, not_and, not_not] using hy
      exact hA' y (hy'.2 hy'.1)

omit [Fintype V] in
theorem chainD_subset_chainX (v₀ : V) : ∀ c : List (V × V × V),
    chainD v₀ c ⊆ chainX v₀ c
  | [] => subset_refl _
  | (_, p, q) :: c => by
    intro x hx
    simp only [chainD, mem_insert] at hx
    rcases hx with rfl | hx
    · simp [chainX]
    · exact mem_insert_of_mem (mem_insert_of_mem (chainD_subset_chainX v₀ c hx))

/-- The original chain's chosen vertices generate the entire chain by local rules. -/
theorem chain_derivable {M : Matrix V V F} {W : Finset V} {v₀ : V}
    (hv₀ : v₀ ∈ W) : ∀ c, GoodChain M W v₀ c →
      ∀ x ∈ chainX v₀ c, Derivable M W (chainD v₀ c) x := by
  intro c
  induction c with
  | nil => intro _ x hx; exact .seed hx
  | cons e c ih =>
    obtain ⟨v, p, q⟩ := e
    intro hc x hx
    have hXW := chainX_subset hv₀ c hc.1
    have hknown : ∀ y ∈ chainX v₀ c,
        Derivable M W (chainD v₀ ((v, p, q) :: c)) y := by
      intro y hy
      exact (ih hc.1 y hy).mono (by simp only [chainD]; exact subset_insert _ _)
    obtain ⟨hp, hq⟩ := GoodChain.mem_pair hc
    obtain ⟨hqr, hqW, hqX⟩ := mem_inter.mp hq |>.imp_right mem_sdiff.mp
    have hpgen : Derivable M W (chainD v₀ ((v, p, q) :: c)) p :=
      .seed (by simp [chainD])
    have hqgen : Derivable M W (chainD v₀ ((v, p, q) :: c)) q := by
      refine .rule (hXW hc.2.1) (mem_inter.mpr ⟨mem_insert_of_mem hqr, hqW⟩) ?_
      intro y hy hyq
      obtain ⟨hyrow, hyW⟩ := mem_inter.mp hy
      by_cases hyX : y ∈ chainX v₀ c
      · exact hknown y hyX
      · have hyv : y ≠ v := fun heq => hyX (heq ▸ hc.2.1)
        have hyr : y ∈ recSet M v := (mem_insert.mp hyrow).resolve_left hyv
        have hypq : y ∈ ({p, q} : Finset V) := hc.2.2.2 ▸
          mem_inter.mpr ⟨hyr, mem_sdiff.mpr ⟨hyW, hyX⟩⟩
        have hyp : y = p := (mem_insert.mp hypq).resolve_right (by simpa using hyq)
        exact hyp ▸ hpgen
    simp only [chainX, mem_insert] at hx
    rcases hx with rfl | rfl | hx
    · exact hpgen
    · exact hqgen
    · exact hknown x hx

theorem chain_outside_le_two {M : Matrix V V F} {W : Finset V} {v₀ : V}
    (hv₀ : v₀ ∈ W) (hroot : (recSet M v₀ ∩ W).card ≤ 2)
    (hstar : ∀ v ∈ W, Star M v) {c : List (V × V × V)}
    (hc : GoodChain M W v₀ c) :
    ∀ u ∈ chainX v₀ c, (recSet M u ∩ (W \ chainX v₀ c)).card ≤ 2 := by
  intro u hu
  by_cases hu0 : u = v₀
  · subst u
    exact (card_le_card (inter_subset_inter_left sdiff_subset)).trans hroot
  · obtain ⟨r, hr, hur⟩ := chain_parent c hc u hu hu0
    rcases hstar u (chainX_subset hv₀ c hc hu) with h2 | ⟨h3, hrecip⟩
    · exact (card_le_card inter_subset_left).trans h2
    · have hrS : r ∈ recSet M u := hrecip r hur
      calc (recSet M u ∩ (W \ chainX v₀ c)).card ≤ ((recSet M u).erase r).card := by
             apply card_le_card
             intro w hw
             obtain ⟨hw1, hw2⟩ := mem_inter.mp hw
             refine mem_erase.mpr ⟨?_, hw1⟩
             rintro rfl
             exact (mem_sdiff.mp hw2).2 hr
        _ = 2 := by rw [card_erase_of_mem hrS, h3]

/-- A directed-support version: the original reciprocity and no-triangle
hypotheses imply a fixed generator set for arbitrary reversible row rules. -/
theorem exists_generators_half {M : Matrix V V F} (htri : RecTriangleFree M) :
    ∀ W : Finset V, (∀ v ∈ W, Star M v) →
      ∃ B, Generates M W B ∧ B.card ≤ W.card / 2 := by
  intro W
  induction W using Finset.strongInduction with
  | H W ih =>
    intro hstar
    have finish : ∀ (A B : Finset V), A ⊆ W → A.Nonempty → B ⊆ A →
        (∀ x ∈ A, Derivable M W B x) → B.card ≤ A.card / 2 →
        ∃ D, Generates M W D ∧ D.card ≤ W.card / 2 := by
      intro A B hAW hne hBA hgen hcard
      obtain ⟨D, hD, hDcard⟩ := ih (W \ A) (sdiff_ssubset hAW hne)
        (fun v hv => hstar v (mem_sdiff.mp hv).1)
      refine ⟨B ∪ D, generates_union hAW hBA hgen hD, ?_⟩
      have hcount := card_sdiff_add_card_eq_card hAW
      have hsum := card_union_le B D
      omega
    by_cases hW : W = ∅
    · subst W
      exact ⟨∅, ⟨subset_refl _, by simp⟩, by simp⟩
    have hne := nonempty_iff_ne_empty.mpr hW
    by_cases hodd : Odd W.card
    · obtain ⟨v₀, hv₀, hroot⟩ := exists_small_rec hstar hodd
      have final : ∀ n, ∀ c, GoodChain M W v₀ c →
          W.card - (chainX v₀ c).card = n →
          ∃ B, Generates M W B ∧ B.card ≤ W.card / 2 := by
        intro n
        induction n using Nat.strong_induction_on with
        | h n ihn =>
          intro c hc hn
          have hXW := chainX_subset hv₀ c hc
          have hcard := chainX_card c hc
          have hDW := chainD_subset_chainX v₀ c
          have hDcard := chainD_card_le (v₀ := v₀) c
          have hgen := chain_derivable hv₀ c hc
          have hsmall := chain_outside_le_two hv₀ hroot hstar hc
          by_cases hone : ∃ u ∈ chainX v₀ c,
              (recSet M u ∩ (W \ chainX v₀ c)).card = 1
          · obtain ⟨u, hu, hone⟩ := hone
            obtain ⟨x, hxset⟩ := card_eq_one.mp hone
            have hxmem : x ∈ recSet M u ∩ (W \ chainX v₀ c) := by
              rw [hxset]; simp
            obtain ⟨hxr, hxW, hxX⟩ := mem_inter.mp hxmem |>.imp_right mem_sdiff.mp
            have hxgen : Derivable M W (chainD v₀ c) x := by
              refine .rule (hXW hu) (mem_inter.mpr ⟨mem_insert_of_mem hxr, hxW⟩) ?_
              intro y hy hyx
              obtain ⟨hyrow, hyW⟩ := mem_inter.mp hy
              apply hgen y
              by_contra hyX
              have hyu : y ≠ u := fun heq => hyX (heq ▸ hu)
              have hyr := (mem_insert.mp hyrow).resolve_left hyu
              have : y ∈ recSet M u ∩ (W \ chainX v₀ c) :=
                mem_inter.mpr ⟨hyr, mem_sdiff.mpr ⟨hyW, hyX⟩⟩
              rw [hxset, mem_singleton] at this
              exact hyx this
            apply finish (insert x (chainX v₀ c)) (chainD v₀ c)
              (insert_subset hxW hXW) (insert_nonempty _ _)
              (hDW.trans (subset_insert _ _))
            · intro y hy
              rcases mem_insert.mp hy with rfl | hy
              · exact hxgen
              · exact hgen y hy
            · rw [card_insert_of_notMem hxX, hcard]
              omega
          · push Not at hone
            by_cases htwo : ∃ u ∈ chainX v₀ c,
                (recSet M u ∩ (W \ chainX v₀ c)).card = 2
            · obtain ⟨u, hu, htwo⟩ := htwo
              obtain ⟨p, q, hpq, hpqset⟩ := card_eq_two.mp htwo
              have hc' : GoodChain M W v₀ ((u, p, q) :: c) := ⟨hc, hu, hpq, hpqset⟩
              have hcount' := chainX_card _ hc'
              have hle' := card_le_card (chainX_subset hv₀ _ hc')
              simp only [List.length_cons] at hcount'
              exact ihn _ (by omega) ((u, p, q) :: c) hc' rfl
            · push Not at htwo
              have hempty : ∀ u ∈ chainX v₀ c,
                  recSet M u ∩ (W \ chainX v₀ c) = ∅ := by
                intro u hu
                have := hsmall u hu
                have := hone u hu
                have := htwo u hu
                exact card_eq_zero.mp (by omega)
              cases c with
              | nil =>
                apply finish {v₀} ∅ (singleton_subset_iff.mpr hv₀)
                  (singleton_nonempty _) (empty_subset _) _ (by simp)
                intro x hx
                have heq : x = v₀ := mem_singleton.mp hx
                subst x
                refine .rule hv₀ (mem_inter.mpr ⟨mem_insert_self _ _, hv₀⟩) ?_
                intro y hy hyv
                obtain ⟨hyr, hyW⟩ := mem_inter.mp hy
                have hyr := (mem_insert.mp hyr).resolve_left hyv
                have hyout : y ∈ recSet M v₀ ∩ (W \ chainX v₀ []) := by
                  simp only [chainX, mem_inter, mem_sdiff, mem_singleton]
                  exact ⟨hyr, hyW, hyv⟩
                rw [hempty v₀ (by simp [chainX])] at hyout
                exact False.elim (notMem_empty _ hyout)
              | cons e rest =>
                obtain ⟨u, p, q⟩ := e
                obtain ⟨hp, hq⟩ := GoodChain.mem_pair hc
                have hqp : q ∉ recSet M p :=
                  htri u p q (mem_inter.mp hp).1 (mem_inter.mp hq).1
                have hpX : p ∈ chainX v₀ ((u, p, q) :: rest) := by simp [chainX]
                have hrestgen := chain_derivable hv₀ rest hc.1
                have hpgen : Derivable M W (chainD v₀ rest) p := by
                  refine .rule (hXW hpX)
                    (mem_inter.mpr ⟨mem_insert_self _ _, hXW hpX⟩) ?_
                  intro y hy hyp
                  obtain ⟨hyrow, hyW⟩ := mem_inter.mp hy
                  have hyr := (mem_insert.mp hyrow).resolve_left hyp
                  apply hrestgen y
                  by_contra hyrest
                  by_cases hyX : y ∈ chainX v₀ ((u, p, q) :: rest)
                  · simp only [chainX, mem_insert] at hyX
                    rcases hyX with heq | heq | hmem
                    · exact hyp heq
                    · exact hqp (heq ▸ hyr)
                    · exact hyrest hmem
                  · have hyout : y ∈ recSet M p ∩ (W \ chainX v₀ ((u, p, q) :: rest)) :=
                      mem_inter.mpr ⟨hyr, mem_sdiff.mpr ⟨hyW, hyX⟩⟩
                    rw [hempty p hpX] at hyout
                    exact notMem_empty _ hyout
                apply finish (chainX v₀ ((u, p, q) :: rest)) (chainD v₀ rest)
                  hXW ⟨p, hpX⟩
                · exact (chainD_subset_chainX v₀ rest).trans
                    (fun x hx => by simp only [chainX, mem_insert]; exact Or.inr (Or.inr hx))
                · intro x hx
                  apply (hgen x hx).bind
                  intro y hy
                  simp only [chainD, mem_insert] at hy
                  rcases hy with rfl | hy
                  · exact hpgen
                  · exact .seed hy
                · have := chainD_card_le (v₀ := v₀) rest
                  simp only [List.length_cons] at hcard
                  omega
      exact final _ [] trivial rfl
    · obtain ⟨v, hv⟩ := hne
      obtain ⟨D, hD, hDcard⟩ := ih (W \ {v})
        (sdiff_ssubset (singleton_subset_iff.mpr hv) (singleton_nonempty _))
        (fun u hu => hstar u (mem_sdiff.mp hu).1)
      refine ⟨{v} ∪ D, generates_union (singleton_subset_iff.mpr hv) (subset_refl _)
        (fun x hx => .seed hx) hD, ?_⟩
      have hsum := card_union_le ({v} : Finset V) D
      have hcount := card_sdiff_add_card_eq_card (singleton_subset_iff.mpr hv)
      have hpar := (Nat.even_or_odd W.card).resolve_right hodd
      obtain ⟨k, hk⟩ := hpar
      simp only [card_singleton] at hsum hcount
      omega

/-- The same rules have at most the matching number of seeds whenever their
supports fit an undirected graph. This retains the directed-support hypotheses. -/
theorem exists_generators_matching {M : Matrix V V F} {G : SimpleGraph V}
    (htri : RecTriangleFree M) (hstar : ∀ v, Star M v)
    (hpat : ∀ v u, u ∈ recSet M v → G.Adj v u) :
    ∃ B, Generates M univ B ∧ B.card ≤ G.matchingNumber := by
  classical
  obtain ⟨U, hU⟩ := G.exists_card_add_sum_card_div_two_eq_matchingNumber
  choose D hD using fun A : Finset V => exists_generators_half htri A (fun v _ => hstar v)
  let S := U ∪ (G.componentBlocks U).biUnion D
  have hDseed : ∀ A ∈ G.componentBlocks U, ∀ x ∈ D A, Derivable M univ S x := by
    intro A hA x hx
    exact .seed (mem_union_right U (mem_biUnion.mpr ⟨A, hA, hx⟩))
  have hUseed : ∀ x ∈ U, Derivable M univ S x :=
    fun x hx => .seed (mem_union_left _ hx)
  refine ⟨S, ⟨subset_univ _, ?_⟩, ?_⟩
  · intro x _
    by_cases hxU : x ∈ U
    · exact hUseed x hxU
    · have hxout : x ∈ (G.componentBlocks U).biUnion id := by
        rw [G.biUnion_componentBlocks]; simp [hxU]
      obtain ⟨A, hA, hxA⟩ := mem_biUnion.mp hxout
      apply ((hD A).1.2 x hxA).lift_of_boundary (subset_univ _) (hDseed A hA)
      intro v hv y hy hyA
      apply hUseed y
      by_contra hyU
      have hyout : y ∈ (G.componentBlocks U).biUnion id := by
        rw [G.biUnion_componentBlocks]; simp [hyU]
      obtain ⟨A', hA', hyA'⟩ := mem_biUnion.mp hyout
      have hneq : A ≠ A' := fun heq => hyA (heq ▸ hyA')
      have hyr : y ∈ recSet M v :=
        (mem_insert.mp (mem_inter.mp hy).1).resolve_left (fun heq => hyA (heq ▸ hv))
      exact G.not_adj_of_mem_componentBlocks U A hA A' hA' hneq v hv y hyA' (hpat v y hyr)
  · have h1 := card_union_le U ((G.componentBlocks U).biUnion D)
    have h2 := card_biUnion_le (s := G.componentBlocks U) (t := D)
    have h3 : ∑ A ∈ G.componentBlocks U, (D A).card ≤
        ∑ A ∈ G.componentBlocks U, A.card / 2 :=
      sum_le_sum (fun A _ => (hD A).2)
    change (U ∪ (G.componentBlocks U).biUnion D).card ≤ _
    omega

/-- A semantic interpretation of the named symmetric row rules on a code. -/
def ReversibleOn {α : Type*} (M : Matrix V V F) (C : Set (V → α)) : Prop :=
  ∀ v x, x ∈ insert v (recSet M v) → ∀ f ∈ C, ∀ g ∈ C,
    (∀ y ∈ insert v (recSet M v), y ≠ x → f y = g y) → f x = g x

/-- Soundness of the finite derivation on an arbitrary vertex subset. -/
theorem Derivable.agreement_of_rules {α : Type*} {M : Matrix V V F}
    {W B : Finset V} {f g : V → α}
    (hrules : ∀ v ∈ W, ∀ x ∈ insert v (recSet M v) ∩ W,
      (∀ y ∈ insert v (recSet M v) ∩ W, y ≠ x → f y = g y) → f x = g x)
    (hB : ∀ x ∈ B, f x = g x) {x : V} (hx : Derivable M W B x) : f x = g x := by
  induction hx with
  | seed hx => exact hB _ hx
  | rule hv hx _ ih => exact hrules _ hv _ hx ih

theorem Derivable.agreement {α : Type*} {M : Matrix V V F}
    {C : Set (V → α)} (hC : ReversibleOn M C) {B : Finset V}
    {f g : V → α} (hf : f ∈ C) (hg : g ∈ C)
    (hB : ∀ x ∈ B, f x = g x) {x : V} (hx : Derivable M univ B x) : f x = g x := by
  induction hx with
  | seed hx => exact hB _ hx
  | @rule v x _ hx _ ih =>
    exact hC v x (mem_inter.mp hx).1 f hf g hg
      (fun y hy hne => ih y (mem_inter.mpr ⟨hy, mem_univ _⟩) hne)

/-- Projection onto a generator set is injective on every compatible code. -/
theorem Generates.projection_injective {α : Type*} {M : Matrix V V F}
    {C : Set (V → α)} (hC : ReversibleOn M C) {B : Finset V}
    (hB : Generates M univ B) :
    Function.Injective (fun f : C => fun x : B => (f : V → α) x) := by
  intro f g hfg
  apply Subtype.ext
  funext x
  exact (hB.2 x (mem_univ _)).agreement hC f.2 g.2
    (fun y hy => congrFun hfg ⟨y, hy⟩)

/-- An alphabet-independent information set, chosen from the rule supports alone. -/
theorem reversible_information_set {M : Matrix V V F} {G : SimpleGraph V}
    (htri : RecTriangleFree M) (hstar : ∀ v, Star M v)
    (hpat : ∀ v u, u ∈ recSet M v → G.Adj v u) :
    ∃ B : Finset V, B.card ≤ G.matchingNumber ∧
      ∀ {α : Type*} {C : Set (V → α)}, ReversibleOn M C →
        Function.Injective (fun f : C => fun x : B => (f : V → α) x) := by
  obtain ⟨B, hB, hcard⟩ := exists_generators_matching htri hstar hpat
  exact ⟨B, hcard, fun hC => hB.projection_injective hC⟩

/-- The finite-alphabet matching bound, without linearity or a uniform law. -/
theorem reversible_card_le {α : Type*} [Fintype α] [Nonempty α]
    {M : Matrix V V F} {G : SimpleGraph V} {C : Set (V → α)}
    (htri : RecTriangleFree M) (hstar : ∀ v, Star M v)
    (hpat : ∀ v u, u ∈ recSet M v → G.Adj v u) (hC : ReversibleOn M C) :
    Nat.card C ≤ (Fintype.card α) ^ G.matchingNumber := by
  classical
  obtain ⟨B, hcard, hinj⟩ := reversible_information_set htri hstar hpat
  have h := Fintype.card_le_of_injective _ (hinj hC)
  rw [Fintype.card_fun, Fintype.card_coe] at h
  rw [Nat.card_eq_fintype_card]
  exact h.trans (Nat.pow_le_pow_right (Fintype.card_pos) hcard)

/-- The dimension bound applies to vector coordinates over any field,
independently of the field used to record the supports. -/
theorem reversible_finrank_le {K A : Type*} [Field K] [AddCommGroup A]
    [Module K A] [FiniteDimensional K A] {M : Matrix V V F} {G : SimpleGraph V}
    (C : Submodule K (V → A)) (htri : RecTriangleFree M) (hstar : ∀ v, Star M v)
    (hpat : ∀ v u, u ∈ recSet M v → G.Adj v u) (hC : ReversibleOn M (C : Set (V → A))) :
    Module.finrank K C ≤ G.matchingNumber * Module.finrank K A := by
  obtain ⟨B, hcard, hinj⟩ := reversible_information_set htri hstar hpat
  let f : C →ₗ[K] (B → A) :=
    { toFun := fun x v => x.val v
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hdim := LinearMap.finrank_le_finrank_of_injective (f := f) (hinj hC)
  have hcod : Module.finrank K (B → A) = B.card * Module.finrank K A := by
    simp [Module.finrank_pi_fintype]
  rw [hcod] at hdim
  exact hdim.trans (Nat.mul_le_mul_right _ hcard)

/-- A support-only matrix, used to reuse the original paper's chain definitions.
Its entries carry no assumption about the alphabet or the recovery functions. -/
def ruleMatrix (R : V → Finset V) : Matrix V V ℚ := fun v u => if u ∈ R v then 1 else 0

@[simp] theorem recSet_ruleMatrix (R : V → Finset V) (v : V) :
    recSet (ruleMatrix R) v = (R v).erase v := by
  ext u
  simp [mem_recSet, ruleMatrix, mem_erase]

@[simp] theorem row_ruleMatrix {R : V → Finset V} (hR : ∀ v, v ∈ R v) (v : V) :
    insert v (recSet (ruleMatrix R) v) = R v := by
  simp [hR]

/-- The named-rule theorem on a triangle-free graph of maximum degree three. -/
theorem named_rules_information_set {G : SimpleGraph V} [DecidableRel G.Adj]
    (R : V → Finset V) (hself : ∀ v, v ∈ R v)
    (hlocal : ∀ v u, u ∈ R v → u ≠ v → G.Adj v u)
    (htri : G.CliqueFree 3) (hdeg : ∀ v, G.degree v ≤ 3) :
    ∃ B : Finset V, B.card ≤ G.matchingNumber ∧
      ∀ {α : Type*} {C : Set (V → α)},
        (∀ v x, x ∈ R v → ∀ f ∈ C, ∀ g ∈ C,
          (∀ y ∈ R v, y ≠ x → f y = g y) → f x = g x) →
        Function.Injective (fun f : C => fun x : B => (f : V → α) x) := by
  have hdiag : ∀ v, ruleMatrix R v v = 1 := by intro v; simp [ruleMatrix, hself]
  have hpat : ∀ v u, v ≠ u → ¬ G.Adj v u → ruleMatrix R v u = 0 := by
    intro v u hne hnot
    simp only [ruleMatrix]
    split_ifs with hu
    · exact False.elim (hnot (hlocal v u hu hne.symm))
    · rfl
  have hrecpat : ∀ v u, u ∈ recSet (ruleMatrix R) v → G.Adj v u := by
    intro v u hu
    simp only [recSet_ruleMatrix, mem_erase] at hu
    exact hlocal v u hu.2 hu.1
  obtain ⟨B, hcard, hB⟩ := reversible_information_set
    (thmSHyp_of_cliqueFree hdiag hpat htri).triangleFree (star_of_degree_le_three hpat hdeg) hrecpat
  refine ⟨B, hcard, ?_⟩
  intro α C hC
  apply hB
  simpa only [ReversibleOn, row_ruleMatrix hself] using hC

/-- A scalar equation can solve for every variable with a nonzero coefficient,
including after restriction to a vertex subset. -/
theorem scalar_row_agreement {M : Matrix V V F} (hdiag : ∀ v, M v v = 1)
    {W : Finset V} {f g : V → F} (hf : f ∈ subCode M W) (hg : g ∈ subCode M W)
    {v x : V} (hv : v ∈ W) (hx : x ∈ insert v (recSet M v) ∩ W)
    (heq : ∀ y ∈ insert v (recSet M v) ∩ W, y ≠ x → f y = g y) : f x = g x := by
  have hz : f - g ∈ subCode M W := (subCode M W).sub_mem hf hg
  have hzero : ∀ y ∈ univ, y ≠ x → M v y * (f - g) y = 0 := by
    intro y _ hyx
    by_cases hyW : y ∈ W
    · by_cases hyr : y ∈ insert v (recSet M v)
      · simp [heq y (mem_inter.mpr ⟨hyr, hyW⟩) hyx]
      · have hyv : y ≠ v := fun h => hyr (by simp [h])
        have hMy : M v y = 0 := by
          by_contra hn
          exact hyr (mem_insert_of_mem (mem_recSet.mpr ⟨hyv, hn⟩))
        simp [hMy]
    · simp [hz.1 y hyW]
  have hsum : M v x * (f x - g x) = 0 := by
    have hrow := hz.2 v hv
    rw [sum_eq_single x hzero (fun hn => False.elim (hn (mem_univ _)))] at hrow
    exact hrow
  have hnonzero : M v x ≠ 0 := by
    rcases mem_insert.mp (mem_inter.mp hx).1 with rfl | hxr
    · rw [hdiag]; exact one_ne_zero
    · exact (mem_recSet.mp hxr).2
  exact sub_eq_zero.mp ((mul_eq_zero.mp hsum).resolve_left hnonzero)

/-- The exact original directed half statement, now obtained from the stronger
reversible-rule generator theorem instead of a separate linear-code induction. -/
theorem original_subCode_half {M : Matrix V V F} (hyp : ThmSHyp M)
    (W : Finset V) (hstar : ∀ v ∈ W, Star M v) :
    Module.finrank F (subCode M W) ≤ W.card / 2 := by
  obtain ⟨B, hB, hcard⟩ := exists_generators_half hyp.triangleFree W hstar
  let f : subCode M W →ₗ[F] (B → F) :=
    { toFun := fun x v => x.val v
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hinj : Function.Injective f := by
    intro x y hxy
    apply Subtype.ext
    funext v
    by_cases hv : v ∈ W
    · exact (hB.2 v hv).agreement_of_rules
        (fun u hu v hv heq => scalar_row_agreement hyp.diag x.2 y.2 hu hv heq)
        (fun u hu => congrFun hxy ⟨u, hu⟩)
    · exact (x.2.1 v hv).trans (y.2.1 v hv).symm
  have hdim := LinearMap.finrank_le_finrank_of_injective (f := f) hinj
  simpa using hdim.trans (by simpa using hcard)

/-- The exact original directed matching bound is a corollary as well. -/
theorem original_matching_bound {M : Matrix V V F} {G : SimpleGraph V}
    (hyp : ThmSHyp M) (hpat : ∀ v u, u ∈ recSet M v → G.Adj v u)
    (hstar : ∀ v, Star M v) :
    Module.finrank F (LinearMap.ker M.mulVecLin) ≤ G.matchingNumber := by
  have hrev : ReversibleOn M (LinearMap.ker M.mulVecLin : Set (V → F)) := by
    intro v x hx f hf g hg heq
    rw [← subCode_univ] at hf hg
    exact scalar_row_agreement hyp.diag hf hg (mem_univ _)
      (mem_inter.mpr ⟨hx, mem_univ _⟩) (fun y hy hne => heq y (mem_inter.mp hy).1 hne)
  simpa using reversible_finrank_le (LinearMap.ker M.mulVecLin)
    hyp.triangleFree hstar hpat hrev

end SubcubicMemo
