-  exact TernaryHorizontal.value_eq sub W _ j hj
-
-theorem value_congr (sub : Bool) (W r : ℕ) : BankWord.Congruent (r*W) (value sub W) :=
-  ScheduledBankRows.value_congr (TernaryHorizontal.update sub W) r
-
-theorem schedule_active (sub : Bool) (W r i : ℕ) (c : SharedRowBank.State) :
-    NativeIO.Active (schedule sub W r i) c :=
-  ScheduledBankRows.schedule_active (TernaryHorizontal.update sub W) r i c
