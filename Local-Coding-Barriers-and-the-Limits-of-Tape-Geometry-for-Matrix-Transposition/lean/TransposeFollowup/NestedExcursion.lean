import TransposeFollowup.PaddingChords

/-! Exact chords generated by one nested open/close excursion. The two ramps
move through 4K spatial blocks. Other nested work between the ramps stays
above their peak. All coordinates below use the actual global time grid.
-/

namespace TransposeFollowup

open Transpose.Tape Transpose.Tape.Impl
set_option autoImplicit false

structure NestedExcursion (r K a c : ℕ) (z : ℤ) (h : ℕ → ℤ) : Prop where
  r_pos : 0 < r
  K_pos : 0 < K
  separated : a + 7 * K * r ≤ c
  rise : ∀ t, a ≤ t → t ≤ a + 4 * K * r → h t = z * r + (t - a : ℕ)
  middle : ∀ t, a + 4 * K * r ≤ t → t ≤ c → (z + 4 * K) * r ≤ h t
  fall : ∀ t, c ≤ t → t ≤ c + 4 * K * r → h t = (z + 4 * K) * r - (t - c : ℕ)

namespace NestedExcursion

variable {r K a c : ℕ} {z : ℤ} {h : ℕ → ℤ} (E : NestedExcursion r K a c z h)
include E

theorem rise_block {j t : ℕ} (ht : a + j * r ≤ t)
    (ht' : t < a + (j + 1) * r) (hpeak : t ≤ a + 4 * K * r) :
    curBlock r h t = z + j := by
  have hta : a ≤ t := by omega
  have hlow : j * r ≤ t - a := by omega
  have hhigh : t - a < (j + 1) * r := by omega
  have hl : (j : ℤ) * r ≤ (t - a : ℕ) := by exact_mod_cast hlow
  have hh : (t - a : ℕ) < ((j : ℤ) + 1) * r := by exact_mod_cast hhigh
  change blockOf r (h t) = _
  apply (blockOf_eq_iff E.r_pos).mpr
  rw [E.rise t hta hpeak]
  constructor <;> nlinarith

theorem exit_blocks {j : ℕ} (hj : j + 2 ≤ 4 * K) :
    curBlock r h (a + (j + 2) * r) = z + j + 2 ∧
    curBlock r h (a + (j + 2) * r - 1) = z + j + 1 := by
  have hr := E.r_pos
  have hjr := Nat.mul_le_mul_right r hj
  have hu : a + (j + 2) * r - 1 + 1 = a + (j + 2) * r :=
    Nat.sub_add_cancel (by nlinarith)
  constructor
  · convert E.rise_block (j := j + 2) (le_refl _) (by nlinarith) (by omega) using 1
    push_cast
    ring
  · convert E.rise_block (j := j + 1) (t := a + (j + 2) * r - 1)
      (by nlinarith) (by nlinarith) (by omega) using 1
    push_cast
    ring

theorem exit_absent {j : ℕ} (hj : j + 2 ≤ 4 * K) :
    z + j ∉ residentPair r h (a + (j + 2) * r) := by
  have hb := E.exit_blocks hj
  have hr := E.r_pos
  rw [residentPair_at_change (by nlinarith) (by rw [hb.1, hb.2]; omega), hb.1, hb.2]
  simp

theorem before_exit_resident {j : ℕ} (hj : j + 2 ≤ 4 * K) :
    z + j ∈ residentPair r h (a + (j + 2) * r - 1) := by
  have hr := E.r_pos
  have hjr := Nat.mul_le_mul_right r hj
  have hτ : 0 < a + (j + 1) * r := by nlinarith
  have hτsub := Nat.sub_add_cancel hτ
  have hrsub := Nat.sub_add_cancel hr
  have husub : a + (j + 2) * r - 1 + 1 = a + (j + 2) * r :=
    Nat.sub_add_cancel (by nlinarith)
  have hb : curBlock r h (a + (j + 1) * r) = z + j + 1 := by
    convert E.rise_block (j := j + 1) (le_refl _) (by nlinarith) (by nlinarith) using 1
    push_cast
    ring
  have hb' : curBlock r h (a + (j + 1) * r - 1) = z + j := by
    exact E.rise_block (j := j) (by nlinarith) (by nlinarith) (by nlinarith)
  have he := residentPair_constant (r := r) (h := h) (a := a + (j + 1) * r) (r - 1)
    (by
      intro t hlo hhi
      rw [hb]
      convert E.rise_block (j := j + 1) hlo (by nlinarith) (by nlinarith) using 1
      push_cast
      ring)
  have ht : a + (j + 1) * r + (r - 1) = a + (j + 2) * r - 1 := by nlinarith
  rw [ht, residentPair_at_change hτ (by rw [hb, hb']; omega), hb, hb'] at he
  rw [he]
  simp

omit E in
theorem tail_identity {j : ℕ} (hj : j + 2 ≤ 4 * K) :
    ((4 * K - j - 1 : ℕ) : ℤ) = 4 * K - j - 1 := by omega

theorem return_time_le {j : ℕ} (hj : j + 2 ≤ 4 * K) :
    c + (4 * K - j - 1) * r + 1 ≤ c + 4 * K * r := by
  have hm := Nat.mul_le_mul_right r (show (4 * K - j - 1) + 1 ≤ 4 * K by omega)
  have hr := E.r_pos
  rw [Nat.add_mul, one_mul] at hm
  omega

theorem height_until_return {j t : ℕ} (hj : j + 2 ≤ 4 * K)
    (ht : a + (j + 2) * r ≤ t) (ht' : t < c + (4 * K - j - 1) * r + 1) :
    (z + j + 1) * r ≤ h t := by
  have hr : (0 : ℤ) < r := by exact_mod_cast E.r_pos
  by_cases hopen : t ≤ a + 4 * K * r
  · rw [E.rise t (by omega) hopen]
    have hn : (j + 2) * r ≤ t - a := by omega
    have hz : ((j : ℤ) + 2) * r ≤ (t - a : ℕ) := by exact_mod_cast hn
    nlinarith
  · by_cases hclose : t ≤ c
    · have hm := E.middle t (by omega) hclose
      have hn := Nat.mul_le_mul_right r (show j + 1 ≤ 4 * K by omega)
      have hz : ((j : ℤ) + 1) * r ≤ 4 * K * r := by exact_mod_cast hn
      nlinarith
    · rw [E.fall t (by omega) (by have := E.return_time_le hj; omega)]
      have hn : t - c ≤ (4 * K - j - 1) * r := by omega
      have hz : (t - c : ℕ) ≤ ((4 * K - j - 1 : ℕ) : ℤ) * r := by exact_mod_cast hn
      rw [tail_identity hj] at hz
      nlinarith

theorem return_block {j : ℕ} (hj : j + 2 ≤ 4 * K) :
    curBlock r h (c + (4 * K - j - 1) * r + 1) = z + j := by
  have hp : h (c + (4 * K - j - 1) * r + 1) = (z + j + 1) * r - 1 := by
    rw [E.fall _ (by omega) (E.return_time_le hj),
      show c + (4 * K - j - 1) * r + 1 - c = (4 * K - j - 1) * r + 1 by omega]
    push_cast
    rw [tail_identity hj]
    ring
  change blockOf r (h _) = _
  apply (blockOf_eq_iff E.r_pos).mpr
  rw [hp]
  have hr : (0 : ℤ) < r := by exact_mod_cast E.r_pos
  constructor <;> nlinarith

theorem residency_gap {j t : ℕ} (hj : j + 2 ≤ 4 * K)
    (ht : a + (j + 2) * r ≤ t) (ht' : t < c + (4 * K - j - 1) * r + 1) :
    z + j ∉ residentPair r h t := by
  have he := residentPair_stays_absent (E.exit_absent hj)
    (t - (a + (j + 2) * r)) (by
      intro s hs hs'
      have hhigh := E.height_until_return hj hs (by omega)
      intro hb
      have hpos := (blockOf_spec E.r_pos (h s)).2
      change h s < (curBlock r h s + 1) * r at hpos
      rw [hb] at hpos
      omega)
  simpa only [Nat.add_sub_of_le ht] using he

theorem chord_slots_separated {j : ℕ} (hj : j + 2 ≤ 4 * K) :
    (a + (j + 2) * r - 1) / r + 1 < (c + (4 * K - j - 1) * r + 1) / r := by
  have hr := E.r_pos
  have hK := E.K_pos
  have hc := E.separated
  have hjr := Nat.mul_le_mul_right r hj
  have hkr : r ≤ K * r := by nlinarith
  have hd := Nat.div_mul_le_self (a + (j + 2) * r - 1) r
  have hu := Nat.sub_le (a + (j + 2) * r) 1
  have hm : ((a + (j + 2) * r - 1) / r + 2) * r ≤
      c + (4 * K - j - 1) * r + 1 := by nlinarith
  have he := (Nat.le_div_iff_mul_le hr).mpr hm
  omega

/-- Every block z,...,z+4K-2 yields an actual pair-residency chord. The +1
in the descending return time and the two-block ascending retention are
derived from current/previous-distinct residency, not a touched-cell model. -/
theorem isChord {j T : ℕ} (hj : j + 2 ≤ 4 * K) (hT : c + 4 * K * r < T) :
    IsChord (pairRes r h T) (z + j)
      ((a + (j + 2) * r - 1) / r) ((c + (4 * K - j - 1) * r + 1) / r) := by
  have hr := E.r_pos
  have hc := E.separated
  have hjr := Nat.mul_le_mul_right r hj
  apply chord_of_residency_gap hr (by nlinarith) (by nlinarith)
    (by have := E.return_time_le hj; omega) (E.before_exit_resident hj)
  · rw [← E.return_block hj]
    exact cur_mem_residentPair _
  · intro t ht ht'
    exact E.residency_gap hj ht ht'
  · exact E.chord_slots_separated hj

end NestedExcursion
end TransposeFollowup
