      #[0, 0, 0, 0, 0, 0, 0, 0, 19, 7, 1, 3, 8, -1, 2, 1]]]

private def d4L1Entry (m : Fin 2) (i r u : ZMod 4) : ℤ :=
  ((d4L1Table.getD m.val #[]).getD i.val #[]).getD (r.val * 4 + u.val) 0

private def d4L2DenEntry (m : Fin 2) (i r u : ZMod 4) : ℤ :=
  ((d4L2DenTable.getD m.val #[]).getD i.val #[]).getD (r.val * 4 + u.val) 0

private theorem d4_int_ident :
    ∀ i c r₀ c₀ : ZMod 4,
      (∑ j : ZMod 4, ∑ v : ZMod 4,
        d4L2DenEntry (halfIntervalPartition4 c) i j v *
          d4L1Entry (halfIntervalPartition4 (v + c)) j r₀ (c₀ - (v + c))) =
        if r₀ = c ∧ c₀ = i then 20 else 0 := by
  decide

private theorem zmod4_sum_shift (g h : ZMod 4 → ℝ) (s : ZMod 4) :
    (∑ u : ZMod 4, g u * h (u + s)) = ∑ c₀ : ZMod 4, g (c₀ - s) * h c₀ := by
  refine Fintype.sum_equiv (Equiv.addRight s) _ _ fun u => ?_
  simp

private theorem d4_coded_comp_eval
    (p : ZMod 4 → Fin 2)
    (A B : Fin 2 → ZMod 4 → ZMod 4 → ZMod 4 → ℤ)
    (hident : ∀ i c r₀ c₀ : ZMod 4,
      (∑ j : ZMod 4, ∑ v : ZMod 4,
        B (p c) i j v * A (p (v + c)) j r₀ (c₀ - (v + c))) =
        if r₀ = c ∧ c₀ = i then 20 else 0) :
    ∃ (K₁ K₂ : State 4 ℝ →ₗ[ℝ] State 4 ℝ),
      ClassUniform p (K₁ : State 4 ℝ → State 4 ℝ) ∧
      ClassUniform p (K₂ : State 4 ℝ → State 4 ℝ) ∧
      K₂.comp K₁ = swapLinear ℝ := by
  let f₁ : Fin 2 → State 4 ℝ → (ZMod 4 → ℝ) := fun m Z i =>
    ∑ r : ZMod 4, ∑ u : ZMod 4, (A m i r u : ℝ) * Z r u
  let f₂ : Fin 2 → State 4 ℝ → (ZMod 4 → ℝ) := fun m Z i =>
    (1 / 20 : ℝ) * ∑ j : ZMod 4, ∑ v : ZMod 4, (B m i j v : ℝ) * Z j v
  let K₁ : State 4 ℝ →ₗ[ℝ] State 4 ℝ :=
    { toFun := fun X i c => f₁ (p c) (rot c X) i
      map_add' := fun X Y => by
        funext i c; simp [f₁, rot_apply, mul_add, Finset.sum_add_distrib]
      map_smul' := fun a X => by
        funext i c; simp [f₁, rot_apply, Finset.mul_sum, mul_left_comm] }
  let K₂ : State 4 ℝ →ₗ[ℝ] State 4 ℝ :=
    { toFun := fun Y i c => f₂ (p c) (rot c Y) i
      map_add' := fun X Y => by
        funext i c; simp [f₂, rot_apply, mul_add, Finset.sum_add_distrib]
      map_smul' := fun a X => by
        funext i c
        simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, f₂, rot_apply]
        rw [← mul_assoc, mul_comm a (1 / 20 : ℝ), mul_assoc]
        congr 1
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun v _ => by ring }
  refine ⟨K₁, K₂, ⟨f₁, fun _ _ _ => rfl⟩, ⟨f₂, fun _ _ _ => rfl⟩, ?_⟩
  apply LinearMap.ext; intro X; funext i c
  change (1 / 20 : ℝ) *
      ∑ j : ZMod 4, ∑ v : ZMod 4,
        (B (p c) i j v : ℝ) *
          (∑ r₀ : ZMod 4, ∑ u : ZMod 4,
            (A (p (v + c)) j r₀ u : ℝ) * X r₀ (u + (v + c))) =
      X c i
  have hshiftSum :
      (∑ j : ZMod 4, ∑ v : ZMod 4,
        (B (p c) i j v : ℝ) *
          (∑ r₀ : ZMod 4, ∑ u : ZMod 4,
            (A (p (v + c)) j r₀ u : ℝ) * X r₀ (u + (v + c)))) =
      ∑ j : ZMod 4, ∑ v : ZMod 4,
        (B (p c) i j v : ℝ) *
          (∑ r₀ : ZMod 4, ∑ c₀ : ZMod 4,
            (A (p (v + c)) j r₀ (c₀ - (v + c)) : ℝ) * X r₀ c₀) := by
    refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun v _ => ?_
    congr 1
    refine Finset.sum_congr rfl fun r₀ _ => ?_
    exact zmod4_sum_shift (fun u => (A (p (v + c)) j r₀ u : ℝ)) (X r₀) (v + c)
  rw [hshiftSum]
  have hswap :
      (∑ j : ZMod 4, ∑ v : ZMod 4,
        (B (p c) i j v : ℝ) *
          (∑ r₀ : ZMod 4, ∑ c₀ : ZMod 4,
            (A (p (v + c)) j r₀ (c₀ - (v + c)) : ℝ) * X r₀ c₀)) =
      ∑ r₀ : ZMod 4, ∑ c₀ : ZMod 4,
        ((∑ j : ZMod 4, ∑ v : ZMod 4,
          (B (p c) i j v : ℝ) *
            (A (p (v + c)) j r₀ (c₀ - (v + c)) : ℝ)) * X r₀ c₀) := by
    calc
      _ = ∑ j : ZMod 4, ∑ v : ZMod 4, ∑ r₀ : ZMod 4, ∑ c₀ : ZMod 4,
            ((B (p c) i j v : ℝ) *
              (A (p (v + c)) j r₀ (c₀ - (v + c)) : ℝ)) * X r₀ c₀ := by
          refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun v _ => ?_
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun r₀ _ => ?_
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl fun c₀ _ => (mul_assoc _ _ _).symm
      _ = ∑ j : ZMod 4, ∑ r₀ : ZMod 4, ∑ v : ZMod 4, ∑ c₀ : ZMod 4,
            ((B (p c) i j v : ℝ) *
              (A (p (v + c)) j r₀ (c₀ - (v + c)) : ℝ)) * X r₀ c₀ := by
          exact Finset.sum_congr rfl fun j _ => Finset.sum_comm
      _ = ∑ r₀ : ZMod 4, ∑ j : ZMod 4, ∑ v : ZMod 4, ∑ c₀ : ZMod 4,
            ((B (p c) i j v : ℝ) *
              (A (p (v + c)) j r₀ (c₀ - (v + c)) : ℝ)) * X r₀ c₀ :=
          Finset.sum_comm
      _ = ∑ r₀ : ZMod 4, ∑ j : ZMod 4, ∑ c₀ : ZMod 4, ∑ v : ZMod 4,
            ((B (p c) i j v : ℝ) *
              (A (p (v + c)) j r₀ (c₀ - (v + c)) : ℝ)) * X r₀ c₀ := by
          exact Finset.sum_congr rfl fun r₀ _ => Finset.sum_congr rfl fun j _ => Finset.sum_comm
      _ = ∑ r₀ : ZMod 4, ∑ c₀ : ZMod 4, ∑ j : ZMod 4, ∑ v : ZMod 4,
            ((B (p c) i j v : ℝ) *
              (A (p (v + c)) j r₀ (c₀ - (v + c)) : ℝ)) * X r₀ c₀ := by
          exact Finset.sum_congr rfl fun r₀ _ => Finset.sum_comm
      _ = _ := by
          refine Finset.sum_congr rfl fun r₀ _ => Finset.sum_congr rfl fun c₀ _ => ?_
          rw [Finset.sum_mul]
          exact Finset.sum_congr rfl fun j _ => (Finset.sum_mul _ _ _).symm
  rw [hswap]
  have hcoeff : ∀ r₀ c₀ : ZMod 4,
      (∑ j : ZMod 4, ∑ v : ZMod 4,
        (B (p c) i j v : ℝ) *
          (A (p (v + c)) j r₀ (c₀ - (v + c)) : ℝ)) =
      if r₀ = c ∧ c₀ = i then (20 : ℝ) else 0 := by
    intro r₀ c₀
    have hint := hident i c r₀ c₀
    have hcast : ((∑ j : ZMod 4, ∑ v : ZMod 4,
        B (p c) i j v * A (p (v + c)) j r₀ (c₀ - (v + c)) : ℤ) : ℝ) =
        ((if r₀ = c ∧ c₀ = i then (20 : ℤ) else 0 : ℤ) : ℝ) := congrArg Int.cast hint
    simpa [Int.cast_sum, Int.cast_mul] using hcast
  have hcoeffSum :
      (∑ r₀ : ZMod 4, ∑ c₀ : ZMod 4,
        ((∑ j : ZMod 4, ∑ v : ZMod 4,
          (B (p c) i j v : ℝ) *
            (A (p (v + c)) j r₀ (c₀ - (v + c)) : ℝ)) * X r₀ c₀)) =
      ∑ r₀ : ZMod 4, ∑ c₀ : ZMod 4,
        (if r₀ = c ∧ c₀ = i then (20 : ℝ) else 0) * X r₀ c₀ := by
    refine Finset.sum_congr rfl fun r₀ _ => Finset.sum_congr rfl fun c₀ _ => ?_
    rw [hcoeff r₀ c₀]
  rw [hcoeffSum]
  have heval :
      (∑ r₀ : ZMod 4, ∑ c₀ : ZMod 4,
        (if r₀ = c ∧ c₀ = i then (20 : ℝ) else 0) * X r₀ c₀) = (20 : ℝ) * X c i := by
    have hinner :
        (∑ r₀ : ZMod 4, ∑ c₀ : ZMod 4,
          (if r₀ = c ∧ c₀ = i then (20 : ℝ) else 0) * X r₀ c₀) =
        ∑ r₀ : ZMod 4, if r₀ = c then (20 : ℝ) * X r₀ i else 0 := by
      refine Finset.sum_congr rfl fun r₀ _ => ?_
      by_cases hr : r₀ = c
      · subst hr
        simp [ite_mul]
      · simp [hr]
    rw [hinner]
    simp
  rw [heval]
  ring

private theorem d4_no_entry_copy_wiring
    (r₁ u₁ r₂ u₂ : Fin 2 → ZMod 4 → ZMod 4)
    (hR : ∀ i c : ZMod 4,
      r₁ (halfIntervalPartition4 (u₂ (halfIntervalPartition4 c) i + c))
        (r₂ (halfIntervalPartition4 c) i) = c)
    (hC : ∀ i c : ZMod 4,
      u₁ (halfIntervalPartition4 (u₂ (halfIntervalPartition4 c) i + c))
        (r₂ (halfIntervalPartition4 c) i) + (u₂ (halfIntervalPartition4 c) i + c) = i) :
    False := by
  have hp0 : halfIntervalPartition4 0 = 0 := by decide
  have hp1 : halfIntervalPartition4 1 = 0 := by decide
  have hp2 : halfIntervalPartition4 2 = 1 := by decide
  have hp3 : halfIntervalPartition4 3 = 1 := by decide
  have hu0 : ∀ i : ZMod 4,
      (u₂ 0 i = 1 ∧ u₁ 0 (r₂ 0 i) - u₁ 1 (r₂ 0 i) = 1 ∧ r₁ 0 (r₂ 0 i) = 0) ∨
      (u₂ 0 i = 3 ∧ u₁ 0 (r₂ 0 i) - u₁ 1 (r₂ 0 i) = 3 ∧ r₁ 0 (r₂ 0 i) = 1) := by
    intro i
    have hr0 := hR i 0
    have hr1 := hR i 1
    have hc0 := hC i 0
    have hc1 := hC i 1
    rw [hp0, add_zero] at hr0 hc0
    rw [hp1] at hr1 hc1
    generalize hu : u₂ 0 i = u at hr0 hr1 hc0 hc1 ⊢
    let j := r₂ 0 i
    fin_cases u
    · change r₁ (halfIntervalPartition4 0) j = 0 at hr0
      change r₁ (halfIntervalPartition4 (0 + 1)) j = 1 at hr1
      rw [zero_add, hp1] at hr1; rw [hp0] at hr0
      exact absurd (hr0.symm.trans hr1) (by decide)
    · left
      change r₁ (halfIntervalPartition4 1) j = 0 at hr0
      change u₁ (halfIntervalPartition4 1) j + 1 = i at hc0
      change u₁ (halfIntervalPartition4 (1 + 1)) j + (1 + 1) = i at hc1
      have hp11 : halfIntervalPartition4 (1 + 1) = 1 := by decide
      rw [hp1] at hr0 hc0
      rw [hp11] at hc1
      refine ⟨rfl, ?_, hr0⟩
      calc u₁ 0 j - u₁ 1 j = (u₁ 0 j + 1) - (u₁ 1 j + (1 + 1)) + 1 := by ring
        _ = i - i + 1 := by rw [hc0, hc1]
        _ = 1 := by ring
    · change r₁ (halfIntervalPartition4 2) j = 0 at hr0
      change r₁ (halfIntervalPartition4 (2 + 1)) j = 1 at hr1
      have hp21 : halfIntervalPartition4 (2 + 1) = 1 := by decide
      rw [hp2] at hr0; rw [hp21] at hr1
      exact absurd (hr0.symm.trans hr1) (by decide)
    · right
      change r₁ (halfIntervalPartition4 3) j = 0 at hr0
      change r₁ (halfIntervalPartition4 (3 + 1)) j = 1 at hr1
      change u₁ (halfIntervalPartition4 3) j + 3 = i at hc0
      change u₁ (halfIntervalPartition4 (3 + 1)) j + (3 + 1) = i at hc1
      have hp31 : halfIntervalPartition4 (3 + 1) = 0 := by decide
      have h31z : (3 + 1 : ZMod 4) = 0 := by decide
      rw [hp3] at hr0 hc0
      rw [hp31] at hr1
      rw [hp31, h31z, add_zero] at hc1
      refine ⟨rfl, ?_, hr1⟩
      calc u₁ 0 j - u₁ 1 j = u₁ 0 j - (u₁ 1 j + 3) + 3 := by ring
        _ = i - i + 3 := by rw [hc1, hc0]
        _ = 3 := by ring
  have hinj : Function.Injective (r₂ 0) := by
    intro i₁ i₂ hj
    have h1 := hu0 i₁
    have h2 := hu0 i₂
    rw [hj] at h1
    have huEq : u₂ 0 i₁ = u₂ 0 i₂ := by
      rcases h1 with ⟨hu1, hd1, _⟩ | ⟨hu1, hd1, _⟩ <;>
        rcases h2 with ⟨hu2, hd2, _⟩ | ⟨hu2, hd2, _⟩
      · exact hu1.trans hu2.symm
      · exfalso; have : (1 : ZMod 4) = 3 := hd1.symm.trans hd2; exact absurd this (by decide)
      · exfalso; have : (3 : ZMod 4) = 1 := hd1.symm.trans hd2; exact absurd this (by decide)
      · exact hu1.trans hu2.symm
    have hc1 := hC i₁ 0
    have hc2 := hC i₂ 0
    rw [hp0, add_zero] at hc1 hc2
    rw [← hc1, ← hc2, hj, huEq]
  have hsurj : Function.Surjective (r₂ 0) := Finite.injective_iff_surjective.mp hinj
  have hr1_01 : ∀ j : ZMod 4, r₁ 0 j = 0 ∨ r₁ 0 j = 1 := by
    intro j
    obtain ⟨i, rfl⟩ := hsurj j
    rcases hu0 i with ⟨_, _, h⟩ | ⟨_, _, h⟩
    · exact Or.inl h
    · exact Or.inr h
  -- Now evaluate c = 2, 3 at i = 0 to force r₁ 0 (r₂ 1 0) ∈ {2, 3}, contradiction!
  have hr2 := hR 0 2
  have hr3 := hR 0 3
  rw [hp2] at hr2
  rw [hp3] at hr3
  let j' := r₂ 1 0
  have h23 : r₁ 0 j' = 2 ∨ r₁ 0 j' = 3 := by
    generalize hu' : u₂ 1 0 = u' at hr2 hr3
    fin_cases u'
    · change r₁ (halfIntervalPartition4 (0 + 2)) j' = 2 at hr2
      change r₁ (halfIntervalPartition4 (0 + 3)) j' = 3 at hr3
      have h02 : halfIntervalPartition4 (0 + 2) = 1 := by decide
      have h03 : halfIntervalPartition4 (0 + 3) = 1 := by decide
      rw [h02] at hr2; rw [h03] at hr3
      exact absurd (hr2.symm.trans hr3) (by decide)
    · right
      change r₁ (halfIntervalPartition4 (1 + 3)) j' = 3 at hr3
      have h13 : halfIntervalPartition4 (1 + 3) = 0 := by decide
      rwa [h13] at hr3
    · change r₁ (halfIntervalPartition4 (2 + 2)) j' = 2 at hr2
      change r₁ (halfIntervalPartition4 (2 + 3)) j' = 3 at hr3
      have h22 : halfIntervalPartition4 (2 + 2) = 0 := by decide
      have h23' : halfIntervalPartition4 (2 + 3) = 0 := by decide
      rw [h22] at hr2; rw [h23'] at hr3
      exact absurd (hr2.symm.trans hr3) (by decide)
    · left
      change r₁ (halfIntervalPartition4 (3 + 2)) j' = 2 at hr2
      have h32 : halfIntervalPartition4 (3 + 2) = 0 := by decide
      rwa [h32] at hr2
  rcases hr1_01 j' with h | h <;> rcases h23 with h' | h' <;>
    exact absurd (h.symm.trans h') (by decide)

theorem control_D4SameIntervalCodedFactorization :
    Control_D4SameIntervalCodedFactorizationSpec := by
  refine ⟨?_, ?_⟩
  · intro Sigma _ hcard
    rintro ⟨K₁, K₂, ⟨r₁, u₁, hK₁⟩, ⟨r₂, u₂, hK₂⟩, hcomp⟩
    have h1lt : 1 < Fintype.card Sigma := by omega
    obtain ⟨s₀, s₁, hne⟩ := Fintype.exists_pair_of_one_lt_card h1lt
    have hwire : ∀ i c : ZMod 4,
        r₁ (halfIntervalPartition4 (u₂ (halfIntervalPartition4 c) i + c))
          (r₂ (halfIntervalPartition4 c) i) = c ∧
        u₁ (halfIntervalPartition4 (u₂ (halfIntervalPartition4 c) i + c))
          (r₂ (halfIntervalPartition4 c) i) + (u₂ (halfIntervalPartition4 c) i + c) = i := by
      intro i c
      let X : State 4 Sigma := fun r col => if r = c ∧ col = i then s₁ else s₀
      have heval : K₂ (K₁ X) i c = swap X i c := by
        have h := congrFun hcomp X
        exact congrFun (congrFun h i) c
      rw [hK₂, rot_apply, hK₁, rot_apply] at heval
      change (if r₁ (halfIntervalPartition4 (u₂ (halfIntervalPartition4 c) i + c))
                  (r₂ (halfIntervalPartition4 c) i) = c ∧
                u₁ (halfIntervalPartition4 (u₂ (halfIntervalPartition4 c) i + c))
                  (r₂ (halfIntervalPartition4 c) i) +
                  (u₂ (halfIntervalPartition4 c) i + c) = i
              then s₁ else s₀) = (if c = c ∧ i = i then s₁ else s₀) at heval
      simp only [and_self, ↓reduceIte] at heval
      by_contra hnot
      simp only [hnot, ↓reduceIte] at heval
      exact hne heval
    exact d4_no_entry_copy_wiring r₁ u₁ r₂ u₂ (fun i c => (hwire i c).1) (fun i c => (hwire i c).2)
  · exact d4_coded_comp_eval halfIntervalPartition4 d4L1Entry d4L2DenEntry d4_int_ident

end D4Control

/-! ### 4. Elementary Cauchy–Schwarz Affine Cube Extraction -/

section CauchySchwarzCube

private theorem nat_cauchy_schwarz_range (Q : ℕ) (a : ℕ → ℕ) :
    (∑ r ∈ Finset.range Q, a r) ^ 2 ≤ Q * ∑ r ∈ Finset.range Q, a r ^ 2 := by
  have hnonneg : (0 : ℤ) ≤
      ∑ r₁ ∈ Finset.range Q, ∑ r₂ ∈ Finset.range Q, ((a r₁ : ℤ) - (a r₂ : ℤ)) ^ 2 :=
    Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => sq_nonneg _
  have hexp :
      (∑ r₁ ∈ Finset.range Q, ∑ r₂ ∈ Finset.range Q, ((a r₁ : ℤ) - (a r₂ : ℤ)) ^ 2) =
      2 * (Q : ℤ) * (∑ r ∈ Finset.range Q, (a r : ℤ) ^ 2) -
        2 * (∑ r ∈ Finset.range Q, (a r : ℤ)) ^ 2 := by
    have h1 : ∀ r₁ : ℕ,
        (∑ r₂ ∈ Finset.range Q, ((a r₁ : ℤ) - (a r₂ : ℤ)) ^ 2) =
        (Q : ℤ) * (a r₁ : ℤ) ^ 2 -
          2 * (a r₁ : ℤ) * (∑ r₂ ∈ Finset.range Q, (a r₂ : ℤ)) +
          ∑ r₂ ∈ Finset.range Q, (a r₂ : ℤ) ^ 2 := by
      intro r₁
      calc
        _ = ∑ r₂ ∈ Finset.range Q,
              (((a r₁ : ℤ) ^ 2 - 2 * (a r₁ : ℤ) * (a r₂ : ℤ)) + (a r₂ : ℤ) ^ 2) := by
            refine Finset.sum_congr rfl fun r₂ _ => by ring
        _ = (∑ r₂ ∈ Finset.range Q, ((a r₁ : ℤ) ^ 2 - 2 * (a r₁ : ℤ) * (a r₂ : ℤ))) +
              ∑ r₂ ∈ Finset.range Q, (a r₂ : ℤ) ^ 2 := Finset.sum_add_distrib
        _ = (∑ r₂ ∈ Finset.range Q, (a r₁ : ℤ) ^ 2) -
              (∑ r₂ ∈ Finset.range Q, 2 * (a r₁ : ℤ) * (a r₂ : ℤ)) +
              ∑ r₂ ∈ Finset.range Q, (a r₂ : ℤ) ^ 2 := by
            rw [Finset.sum_sub_distrib]
        _ = _ := by
            simp [Finset.mul_sum]
    simp_rw [h1]
    rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
    simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul, ← Finset.mul_sum,
      ← Finset.sum_mul]
    ring
  rw [hexp] at hnonneg
  have hz : (∑ r ∈ Finset.range Q, (a r : ℤ)) ^ 2 ≤
      (Q : ℤ) * ∑ r ∈ Finset.range Q, (a r : ℤ) ^ 2 := by linarith
  exact_mod_cast hz

private theorem card_strict_pairs_finset (B : Finset ℕ) :
    2 * ((B ×ˢ B).filter (fun p : ℕ × ℕ => p.1 < p.2)).card + B.card = B.card ^ 2 := by
  let ltSet := (B ×ˢ B).filter (fun p : ℕ × ℕ => p.1 < p.2)
  let gtSet := (B ×ˢ B).filter (fun p : ℕ × ℕ => p.2 < p.1)
  let eqSet := (B ×ˢ B).filter (fun p : ℕ × ℕ => p.1 = p.2)
  have hbij : ltSet.card = gtSet.card := by
    apply Finset.card_bij (fun p _ => (p.2, p.1))
    · intro p hp
      simp only [ltSet, gtSet, Finset.mem_filter, Finset.mem_product] at hp ⊢
      exact ⟨⟨hp.1.2, hp.1.1⟩, hp.2⟩
    · intro p₁ _ p₂ _ h
      ext <;> simp_all
    · intro p hp
      refine ⟨(p.2, p.1), ?_, by simp⟩
      simp only [ltSet, gtSet, Finset.mem_filter, Finset.mem_product] at hp ⊢
      exact ⟨⟨hp.1.2, hp.1.1⟩, hp.2⟩
  have heq : eqSet.card = B.card := by
    apply Finset.card_bij (fun p _ => p.1)
    · intro p hp
      simp only [eqSet, Finset.mem_filter, Finset.mem_product] at hp
      exact hp.1.1
    · intro p₁ hp₁ p₂ hp₂ h
      simp only [eqSet, Finset.mem_filter, Finset.mem_product] at hp₁ hp₂
      ext
      · exact h
      · exact hp₁.2.symm.trans (h.trans hp₂.2)
    · intro x hx
      refine ⟨(x, x), ?_, rfl⟩
      simp [eqSet, hx]
  have hdisj1 : Disjoint ltSet gtSet := by
    rw [Finset.disjoint_left]
    intro p h1 h2
    simp only [ltSet, gtSet, Finset.mem_filter] at h1 h2
    omega
  have hdisj2 : Disjoint (ltSet ∪ gtSet) eqSet := by
    rw [Finset.disjoint_left]
    intro p h12 h3
    simp only [ltSet, gtSet, eqSet, Finset.mem_union, Finset.mem_filter] at h12 h3
    rcases h12 with h1 | h2 <;> omega
  have hunion : (ltSet ∪ gtSet) ∪ eqSet = B ×ˢ B := by
    ext p
    simp only [ltSet, gtSet, eqSet, Finset.mem_union, Finset.mem_filter, Finset.mem_product]
    constructor
    · rintro ((⟨h, _⟩ | ⟨h, _⟩) | ⟨h, _⟩) <;> exact h
    · intro hp
      rcases lt_trichotomy p.1 p.2 with hlt | heq' | hgt
      · exact Or.inl (Or.inl ⟨hp, hlt⟩)
      · exact Or.inr ⟨hp, heq'⟩
      · exact Or.inl (Or.inr ⟨hp, hgt⟩)
  have htot : (ltSet ∪ gtSet ∪ eqSet).card = (B ×ˢ B).card := congrArg Finset.card hunion
  rw [Finset.card_union_of_disjoint hdisj2, Finset.card_union_of_disjoint hdisj1,
    Finset.card_product, ← hbij, heq] at htot
  change 2 * ltSet.card + B.card = B.card ^ 2
  rw [sq]
  omega

/-- One Cauchy–Schwarz difference-extraction step in `[0, d)`. -/
private theorem cs_step {d Q : ℕ} (hQ : 0 < Q) (hQL : Q ≤ d)
    {S : Finset ℕ} (hS : S ⊆ Finset.range d) :
    ∃ s : ℕ, (1 ≤ s ∧ s ≤ d / Q) ∧
      S.card * (S.card - Q) ≤ 2 * d * (S.filter (fun x => x + s ∈ S)).card := by
  let L₀ := d / Q
  have hL₀ : 1 ≤ L₀ := Nat.div_pos hQL hQ
  by_cases hN : S.card ≤ Q
  · refine ⟨1, ⟨le_rfl, hL₀⟩, ?_⟩
    have h0 : S.card - Q = 0 := Nat.sub_eq_zero_of_le hN
    simp [h0]
  have hN' : Q < S.card := by omega
  let B : ℕ → Finset ℕ := fun r => S.filter (fun x => x / (L₀ + 1) = r)
  have hpart : (Finset.range Q).biUnion B = S := by
    ext x
    simp only [Finset.mem_biUnion, Finset.mem_range, B, Finset.mem_filter]
    constructor
    · rintro ⟨_, _, hx, _⟩; exact hx
    · intro hx
      have hxd : x < d := Finset.mem_range.mp (hS hx)
      have hdlt : d < Q * (L₀ + 1) := by
        have hmod := Nat.div_add_mod d Q
        have hrem := Nat.mod_lt d hQ
        change Q * L₀ + d % Q = d at hmod
        nlinarith
      refine ⟨x / (L₀ + 1), Nat.div_lt_of_lt_mul (by linarith), hx, rfl⟩
  have hdisjB : Set.PairwiseDisjoint (↑(Finset.range Q) : Set ℕ) B := by
    intro r₁ _ r₂ _ hne
    rw [Function.onFun, Finset.disjoint_left]
    intro x hx1 hx2
    simp only [B, Finset.mem_filter] at hx1 hx2
    exact hne (hx1.2.symm.trans hx2.2)
  have hsumA : ∑ r ∈ Finset.range Q, (B r).card = S.card := by
    rw [← Finset.card_biUnion hdisjB, hpart]
  -- Same-bucket ordered pairs inject into shifted intersections `(s, x)` with `s ∈ Icc 1 L₀`.
  let bucketPairs := (Finset.range Q).biUnion fun r =>
    (B r ×ˢ B r).filter (fun p : ℕ × ℕ => p.1 < p.2)
  have hdisjP : Set.PairwiseDisjoint (↑(Finset.range Q) : Set ℕ)
      (fun r => (B r ×ˢ B r).filter (fun p : ℕ × ℕ => p.1 < p.2)) := by
    intro r₁ _ r₂ _ hne
    rw [Function.onFun, Finset.disjoint_left]
    intro p hp1 hp2
    simp only [Finset.mem_filter, Finset.mem_product, B] at hp1 hp2
    exact hne (hp1.1.1.2.symm.trans hp2.1.1.2)
  have hcardP :
      2 * bucketPairs.card + S.card = ∑ r ∈ Finset.range Q, (B r).card ^ 2 := by
    rw [Finset.card_biUnion hdisjP, Finset.mul_sum, ← hsumA, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun r _ => card_strict_pairs_finset (B r)
  let stepPairs := (Finset.Icc 1 L₀).biUnion fun s =>
    (S.filter (fun x => x + s ∈ S)).map ⟨fun x => (s, x), fun _ _ h => (Prod.mk.inj h).2⟩
  have hdisjS : Set.PairwiseDisjoint (↑(Finset.Icc 1 L₀) : Set ℕ)
      (fun s => (S.filter (fun x => x + s ∈ S)).map
        ⟨fun x => (s, x), fun _ _ h => (Prod.mk.inj h).2⟩) := by
    intro s₁ _ s₂ _ hne
    rw [Function.onFun, Finset.disjoint_left]
    intro p hp1 hp2
    simp only [Finset.mem_map] at hp1 hp2
    obtain ⟨x₁, _, hx₁⟩ := hp1
    obtain ⟨x₂, _, hx₂⟩ := hp2
    exact hne ((congrArg Prod.fst hx₁).trans (congrArg Prod.fst hx₂).symm)
  have hcardStep :
      stepPairs.card = ∑ s ∈ Finset.Icc 1 L₀, (S.filter (fun x => x + s ∈ S)).card := by
    rw [Finset.card_biUnion hdisjS]
    exact Finset.sum_congr rfl fun s _ => Finset.card_map _
  have hinjPairs : bucketPairs.card ≤ stepPairs.card := by
    apply Finset.card_le_card_of_injOn (fun p : ℕ × ℕ => (p.2 - p.1, p.1))
    · intro p hp
      change p ∈ (Finset.range Q).biUnion
        (fun r => (B r ×ˢ B r).filter (fun p : ℕ × ℕ => p.1 < p.2)) at hp
      rw [Finset.mem_biUnion] at hp
      obtain ⟨r, _, hp⟩ := hp
      rw [Finset.mem_filter, Finset.mem_product] at hp
      obtain ⟨⟨hxB, hyB⟩, hxy⟩ := hp
      simp only [B, Finset.mem_filter] at hxB hyB
      obtain ⟨hxS, hxr⟩ := hxB
      obtain ⟨hyS, hyr⟩ := hyB
      have hs1 : 1 ≤ p.2 - p.1 := by omega
      have hxlo : r * (L₀ + 1) ≤ p.1 := by
        have := Nat.div_mul_le_self p.1 (L₀ + 1)
        rwa [hxr] at this
      have hyhi : p.2 < (r + 1) * (L₀ + 1) := by
        have hpos : 0 < L₀ + 1 := by omega
        exact (Nat.div_lt_iff_lt_mul hpos).mp (by omega)
      have hs2 : p.2 - p.1 ≤ L₀ := by
        have hstep : p.2 < p.1 + (L₀ + 1) := by
          calc p.2 < (r + 1) * (L₀ + 1) := hyhi
            _ = r * (L₀ + 1) + (L₀ + 1) := by ring
            _ ≤ p.1 + (L₀ + 1) := Nat.add_le_add_right hxlo _
        omega
      change (p.2 - p.1, p.1) ∈ (Finset.Icc 1 L₀).biUnion fun s =>
        (S.filter (fun x => x + s ∈ S)).map ⟨fun x => (s, x), fun _ _ h => (Prod.mk.inj h).2⟩
      rw [Finset.mem_biUnion]
      refine ⟨p.2 - p.1, Finset.mem_Icc.mpr ⟨hs1, hs2⟩, ?_⟩
      rw [Finset.mem_map]
      refine ⟨p.1, Finset.mem_filter.mpr ⟨hxS, ?_⟩, rfl⟩
      have hadd : p.1 + (p.2 - p.1) = p.2 := by omega
      rwa [hadd]
    · intro p₁ hp₁ p₂ hp₂ heq
      change p₁ ∈ (Finset.range Q).biUnion
        (fun r => (B r ×ˢ B r).filter (fun p : ℕ × ℕ => p.1 < p.2)) at hp₁
      change p₂ ∈ (Finset.range Q).biUnion
        (fun r => (B r ×ˢ B r).filter (fun p : ℕ × ℕ => p.1 < p.2)) at hp₂
      rw [Finset.mem_biUnion] at hp₁ hp₂
      obtain ⟨_, _, hp₁⟩ := hp₁
      obtain ⟨_, _, hp₂⟩ := hp₂
      rw [Finset.mem_filter] at hp₁ hp₂
      have hlt₁ := hp₁.2
      have hlt₂ := hp₂.2
      have hfst : p₁.2 - p₁.1 = p₂.2 - p₂.1 := congrArg Prod.fst heq
      have hsnd : p₁.1 = p₂.1 := congrArg Prod.snd heq
      ext
      · exact hsnd
      · omega
  have hcs := nat_cauchy_schwarz_range Q (fun r => (B r).card)
  rw [hsumA] at hcs
  -- Hence `S.card * (S.card - Q) ≤ 2 * Q * stepPairs.card`.
  have hstepBound : S.card * (S.card - Q) ≤ 2 * Q * stepPairs.card := by
    have hle : Q * (2 * bucketPairs.card + S.card) ≤ Q * (2 * stepPairs.card + S.card) :=
      Nat.mul_le_mul_left Q (by omega)
    rw [hcardP] at hle
    have hcomb : S.card ^ 2 ≤ Q * (2 * stepPairs.card + S.card) := le_trans hcs hle
    have hsub : S.card * (S.card - Q) + Q * S.card = S.card ^ 2 := by
      have : S.card * (S.card - Q) + S.card * Q = S.card * (S.card - Q + Q) :=
        (Nat.mul_add _ _ _).symm
      have hadd : S.card - Q + Q = S.card := by omega
      nlinarith
    nlinarith
  -- Pick `s ∈ Icc 1 L₀` maximizing `(S.filter (x + s ∈ S)).card`.
  have hneIcc : (Finset.Icc 1 L₀).Nonempty := Finset.nonempty_Icc.mpr hL₀
  obtain ⟨s, hsIcc, hsMax⟩ :=
    Finset.exists_max_image (Finset.Icc 1 L₀) (fun s => (S.filter (fun x => x + s ∈ S)).card) hneIcc
  have hsumLe : stepPairs.card ≤ L₀ * (S.filter (fun x => x + s ∈ S)).card := by
    rw [hcardStep]
    calc
      ∑ s' ∈ Finset.Icc 1 L₀, (S.filter (fun x => x + s' ∈ S)).card
        ≤ ∑ _ ∈ Finset.Icc 1 L₀, (S.filter (fun x => x + s ∈ S)).card :=
          Finset.sum_le_sum fun s' hs' => hsMax s' hs'
      _ = L₀ * (S.filter (fun x => x + s ∈ S)).card := by
          simp [Nat.card_Icc, show L₀ + 1 - 1 = L₀ by omega]
  have hQLd : Q * L₀ ≤ d := Nat.mul_div_le d Q
  refine ⟨s, Finset.mem_Icc.mp hsIcc, ?_⟩
  calc
    S.card * (S.card - Q)
      ≤ 2 * Q * (L₀ * (S.filter (fun x => x + s ∈ S)).card) :=
        le_trans hstepBound (Nat.mul_le_mul_left (2 * Q) hsumLe)
    _ = 2 * (Q * L₀) * (S.filter (fun x => x + s ∈ S)).card := by ring
    _ ≤ 2 * d * (S.filter (fun x => x + s ∈ S)).card :=
        Nat.mul_le_mul_right _ (Nat.mul_le_mul_left 2 hQLd)

private def cubeDenom (M₁ t : ℕ) : ℚ :=
  (2 : ℚ) ^ (2 ^ t - 1) * (M₁ : ℚ) ^ (2 ^ t)

private theorem cubeDenom_zero (M₁ : ℕ) : cubeDenom M₁ 0 = (M₁ : ℚ) := by
  simp [cubeDenom]

private theorem cubeDenom_succ (M₁ t : ℕ) :
    cubeDenom M₁ (t + 1) = 2 * (cubeDenom M₁ t) ^ 2 := by
  unfold cubeDenom
  have hpos : 1 ≤ 2 ^ t := Nat.one_le_two_pow
  have hexp1 : 2 ^ (t + 1) - 1 = 1 + (2 ^ t - 1) * 2 := by
    rw [pow_succ']
    omega
  have hexp2 : 2 ^ (t + 1) = (2 ^ t) * 2 := by rw [pow_succ']; ring
  rw [hexp1, hexp2, pow_add, pow_one, pow_mul, pow_mul]
  ring

private theorem cubeDenom_pos {M₁ : ℕ} (hM₁ : 1 ≤ M₁) (t : ℕ) :
    0 < cubeDenom M₁ t := by
  unfold cubeDenom
  have hM₁q : (0 : ℚ) < (M₁ : ℚ) := by exact_mod_cast (show 0 < M₁ by omega)
  positivity

private theorem cubeDenom_ge_two {M₁ : ℕ} (hM₁ : 1 ≤ M₁) {t : ℕ} (ht : 1 ≤ t) :
    (2 : ℚ) ≤ cubeDenom M₁ t := by
  unfold cubeDenom
  have h2t : 2 ≤ 2 ^ t := by
    calc 2 = 2 ^ 1 := rfl
      _ ≤ 2 ^ t := Nat.pow_le_pow_right (by omega) ht
  have hpow2 : (2 : ℚ) ≤ (2 : ℚ) ^ (2 ^ t - 1) := by
    have h1 : 1 ≤ 2 ^ t - 1 := by omega
    calc (2 : ℚ) = (2 : ℚ) ^ 1 := by ring
      _ ≤ (2 : ℚ) ^ (2 ^ t - 1) := pow_le_pow_right₀ (by norm_num) h1
  have hpowM : (1 : ℚ) ≤ (M₁ : ℚ) ^ (2 ^ t) :=
    one_le_pow₀ (by exact_mod_cast hM₁)
  nlinarith

private theorem cubeDenom_mono {M₁ : ℕ} (hM₁ : 1 ≤ M₁) :
    Monotone (cubeDenom M₁) := by
  apply monotone_nat_of_le_succ
  intro t
  rw [cubeDenom_succ]
  have hge1 : (1 : ℚ) ≤ cubeDenom M₁ t := by
    unfold cubeDenom
    have h1 : (1 : ℚ) ≤ (2 : ℚ) ^ (2 ^ t - 1) := one_le_pow₀ (by norm_num)
    have h2 : (1 : ℚ) ≤ (M₁ : ℚ) ^ (2 ^ t) := one_le_pow₀ (by exact_mod_cast hM₁)
    nlinarith
  nlinarith

private theorem nat_three_sq_lt_two_exp_pow :
    ∀ m : ℕ, 3 ≤ m → 3 * m ^ 2 < 2 * 2 ^ (2 ^ (m - 1)) := by
  intro m hm
  have hlin : ∀ k : ℕ, 3 ≤ k → k + 1 ≤ 2 ^ (k - 1) := by
    intro k hk
    induction k with
    | zero => omega
    | succ n ih =>
        by_cases hn : n = 2
        · subst hn; norm_num
        · have hn3 : 3 ≤ n := by omega
          have hi := ih hn3
          have heq : n - 1 + 1 = n := by omega
          calc n + 1 + 1 ≤ 2 * (n + 1) := by omega
            _ ≤ 2 * 2 ^ (n - 1) := Nat.mul_le_mul_left 2 hi
            _ = 2 ^ (n - 1 + 1) := (pow_succ' 2 (n - 1)).symm
            _ = 2 ^ n := by rw [heq]
  have hquad : ∀ n : ℕ, 4 ≤ n → 3 * (n - 1) ^ 2 < 2 * 2 ^ n := by
    intro n hn
    induction n with
    | zero => omega
    | succ k ih =>
        by_cases hk : k = 3
        · subst hk; norm_num
        · have hk4 : 4 ≤ k := by omega
          have hi := ih hk4
          have hstep : 3 * k ^ 2 ≤ 2 * (3 * (k - 1) ^ 2) := by
            have hk1 : 1 ≤ k := by omega
            zify [hk1]
            nlinarith
          calc 3 * k ^ 2 ≤ 2 * (3 * (k - 1) ^ 2) := hstep
            _ < 2 * (2 * 2 ^ k) := by omega
            _ = 2 * 2 ^ (k + 1) := by rw [pow_succ']
  have h1 := hlin m hm
  have h2 := hquad (m + 1) (by omega)
  simp only [Nat.add_sub_cancel] at h2
  have hpow : 2 ^ (m + 1) ≤ 2 ^ (2 ^ (m - 1)) := Nat.pow_le_pow_right (by omega) h1
  linarith

private theorem div_cubeDenom_gt_three_half_Q
    {d M₁ M₂ : ℕ} (hM₁ : 1 ≤ M₁) (hM₂ : 2 ≤ M₂)
    (hd : max (8 * M₁ * M₂ ^ 2) ((2 * M₁) ^ (2 ^ M₂)) < d) :
    (3 : ℚ) * (2 * M₂ ^ 2 : ℕ) / 2 < (d : ℚ) / cubeDenom M₁ (M₂ - 1) := by
  have hd1 : 8 * M₁ * M₂ ^ 2 < d := lt_of_le_of_lt (le_max_left _ _) hd
  have hd2 : (2 * M₁) ^ (2 ^ M₂) < d := lt_of_le_of_lt (le_max_right _ _) hd
  have hposB := cubeDenom_pos hM₁ (M₂ - 1)
  rw [div_lt_div_iff₀ (by norm_num) hposB]
  by_cases hM₂2 : M₂ = 2
  · subst hM₂2
    by_cases hM₁1 : M₁ = 1
    · subst hM₁1
      have hd33 : 33 ≤ d := by omega
      have hdq : (33 : ℚ) ≤ (d : ℚ) := by exact_mod_cast hd33
      norm_num [cubeDenom]
      linarith
    · have hM₁2 : 2 ≤ M₁ := by omega
      have hsq4 : 4 ≤ M₁ ^ 2 := by nlinarith
      have hpow4 : (2 * M₁) ^ 4 = 16 * (M₁ ^ 2) * (M₁ ^ 2) := by ring
      have hnat : 3 * 8 * (2 * M₁ ^ 2) < 2 * (2 * M₁) ^ 4 := by
        rw [hpow4]
        nlinarith
      have hd2' : (2 * M₁) ^ 4 < d := by simpa using hd2
      have hlt : 3 * 8 * (2 * M₁ ^ 2) < 2 * d := lt_trans hnat (by omega)
      have hltq : ((3 * 8 * (2 * M₁ ^ 2) : ℕ) : ℚ) < ((2 * d : ℕ) : ℚ) := by exact_mod_cast hlt
      norm_num [cubeDenom]
      push_cast at hltq ⊢
      linarith
  · have hM₂3 : 3 ≤ M₂ := by omega
    let P := 2 ^ (M₂ - 1)
    have hPpos : 1 ≤ P := Nat.one_le_two_pow
    have h2M₂ : 2 ^ M₂ = 2 * P := by
      have : M₂ = (M₂ - 1) + 1 := by omega
      rw [this, pow_succ']
    have h2B : 2 * cubeDenom M₁ (M₂ - 1) = (2 * (M₁ : ℚ)) ^ P := by
      unfold cubeDenom
      change 2 * ((2 : ℚ) ^ (P - 1) * (M₁ : ℚ) ^ P) = _
      have h2P : (2 : ℚ) * (2 : ℚ) ^ (P - 1) = (2 : ℚ) ^ P := by
        rw [← pow_succ', show P - 1 + 1 = P by omega]
      calc 2 * ((2 : ℚ) ^ (P - 1) * (M₁ : ℚ) ^ P)
        _ = ((2 : ℚ) * (2 : ℚ) ^ (P - 1)) * (M₁ : ℚ) ^ P := by ring
        _ = (2 : ℚ) ^ P * (M₁ : ℚ) ^ P := by rw [h2P]
        _ = (2 * (M₁ : ℚ)) ^ P := (mul_pow 2 (M₁ : ℚ) P).symm
    have hexp := nat_three_sq_lt_two_exp_pow M₂ hM₂3
    have h2le : 2 ^ P ≤ (2 * M₁) ^ P := Nat.pow_le_pow_left (by omega) P
    have hstepNat : 3 * M₂ ^ 2 * (2 * M₁) ^ P < 2 * ((2 * M₁) ^ P) ^ 2 := by
      have hposPow : 0 < (2 * M₁) ^ P := Nat.pos_of_ne_zero (by positivity)
      have hlt1 : 3 * M₂ ^ 2 < 2 * (2 * M₁) ^ P := lt_of_lt_of_le hexp (Nat.mul_le_mul_left 2 h2le)
      nlinarith
    have hsq : ((2 * M₁) ^ P) ^ 2 = (2 * M₁) ^ (2 ^ M₂) := by
      rw [h2M₂, pow_mul', sq]
    rw [hsq] at hstepNat
    have hfinNat : 3 * M₂ ^ 2 * (2 * M₁) ^ P < 2 * d := lt_trans hstepNat (by omega)
    have hfinQ : ((3 * M₂ ^ 2 * (2 * M₁) ^ P : ℕ) : ℚ) < ((2 * d : ℕ) : ℚ) := by
      exact_mod_cast hfinNat
    push_cast at hfinQ ⊢
    rw [← h2B] at hfinQ
    linarith

/-- Inductive `k`-cube extraction from `S₀`. -/
private def CubeInSet (S₀ : Finset ℕ) : (k : ℕ) → (Fin k → ℕ) → Finset ℕ → Prop
  | 0, _, S => S ⊆ S₀
  | k + 1, s, S =>
      ∀ x ∈ S, ∀ ε : Fin (k + 1) → Bool,
        x + (∑ i : Fin (k + 1), if ε i then s i else 0) ∈ S₀

private theorem cubeInSet_iff {S₀ : Finset ℕ} {k : ℕ} (s : Fin k → ℕ) (S : Finset ℕ) :
    (∀ x ∈ S, ∀ ε : Fin k → Bool, x + (∑ i : Fin k, if ε i then s i else 0) ∈ S₀) ↔
      S ⊆ S₀ ∧ (k = 0 ∨ CubeInSet S₀ k s S) := by
  cases k with
  | zero =>
      simp [CubeInSet, Finset.subset_iff]
  | succ k =>
      constructor
      · intro h
        refine ⟨fun x hx => ?_, Or.inr h⟩
        simpa using h x hx (fun _ => false)
      · rintro ⟨_, h | h⟩
        · cases h
        · exact h

theorem cauchySchwarzAffineCubeExtraction : CauchySchwarzAffineCubeExtractionSpec := by
  intro d M₁ M₂ _ p₁ hM₁ hM₂ hd
  classical
  let Q := 2 * M₂ ^ 2
  let L₀ := d / Q
  have hQpos : 0 < Q := by positivity
  have hd1 : 8 * M₁ * M₂ ^ 2 < d := lt_of_le_of_lt (le_max_left _ _) hd
  have hQL : Q ≤ d := by dsimp only [Q]; nlinarith
  -- Step 1: Popular color class `S₀ ⊆ range d` with `M₁ * S₀.card ≥ d`.
  let C : Fin M₁ → Finset ℕ := fun m => (Finset.range d).filter (fun x => p₁ (x : ZMod d) = m)
  have hpartC : Finset.univ.biUnion C = Finset.range d := by
    ext x
    simp [C]
  have hdisjC : Set.PairwiseDisjoint (↑(Finset.univ : Finset (Fin M₁)) : Set (Fin M₁)) C := by
    intro m₁ _ m₂ _ hne
    rw [Function.onFun, Finset.disjoint_left]
    intro x hx1 hx2
    simp only [C, Finset.mem_filter] at hx1 hx2
    exact hne (hx1.2.symm.trans hx2.2)
  have hsumC : ∑ m : Fin M₁, (C m).card = d := by
    have := congrArg Finset.card hpartC
    rwa [Finset.card_biUnion hdisjC, Finset.card_range] at this
  have hneM₁ : (Finset.univ : Finset (Fin M₁)).Nonempty :=
    Finset.univ_nonempty_iff.mpr ⟨⟨0, by omega⟩⟩
  obtain ⟨m₀, _, hm₀Max⟩ := Finset.exists_max_image Finset.univ (fun m => (C m).card) hneM₁
  let S₀ := C m₀
  have hN₀ : d ≤ M₁ * S₀.card := by
    calc d = ∑ m : Fin M₁, (C m).card := hsumC.symm
      _ ≤ ∑ _ : Fin M₁, S₀.card := Finset.sum_le_sum fun m _ => hm₀Max m (Finset.mem_univ m)
      _ = M₁ * S₀.card := by simp
  have hS₀sub : S₀ ⊆ Finset.range d := Finset.filter_subset _ _
  -- Handle `M₂ = 1` directly in one `cs_step`, then `M₂ ≥ 2` by induction up to `M₂ - 1`.
  by_cases hM₂1 : M₂ = 1
  · subst hM₂1
    have hQ2 : Q = 2 := by simp [Q]
    have hS₀gt : Q < S₀.card := by
      rw [hQ2]
      nlinarith
    obtain ⟨s₀, hs₀, hcard₁⟩ := cs_step hQpos hQL hS₀sub
    let S₁ := S₀.filter (fun x => x + s₀ ∈ S₀)
    have hposProd : 0 < S₀.card * (S₀.card - Q) := Nat.mul_pos (by omega) (by omega)
    have hposS₁ : 0 < S₁.card := by
      change S₀.card * (S₀.card - Q) ≤ 2 * d * S₁.card at hcard₁
      by_contra h0
      have h0' : S₁.card = 0 := by omega
      rw [h0', mul_zero] at hcard₁
      omega
    obtain ⟨x₀, hx₀⟩ := Finset.card_pos.mp hposS₁
    simp only [S₁, Finset.mem_filter, S₀, C] at hx₀
    obtain ⟨⟨_, hx₀p⟩, ⟨_, hxs₀p⟩⟩ := hx₀
    refine ⟨(x₀ : ZMod d), fun _ => s₀, fun _ => ?_, fun ε => ?_⟩
    · simpa [L₀, Q] using hs₀
    · rw [Fin.sum_univ_one]
      cases ε 0
      · simp [hx₀p]
      · simp only [↓reduceIte]
        have hcast : (x₀ : ZMod d) + (s₀ : ZMod d) = ((x₀ + s₀ : ℕ) : ZMod d) := by push_cast; rfl
        rw [hcast, hxs₀p, hx₀p]
  · have hM₂2 : 2 ≤ M₂ := by omega
    have hEnd := div_cubeDenom_gt_three_half_Q hM₁ hM₂2 hd
    -- Construct `(s, S)` for `0 ≤ t ≤ M₂ - 1` by induction on `t`.
    have hexists : ∀ t : ℕ, t ≤ M₂ - 1 →
        ∃ (s : Fin t → ℕ) (S : Finset ℕ),
          S ⊆ Finset.range d ∧
          (∀ i : Fin t, 1 ≤ s i ∧ s i ≤ L₀) ∧
          (∀ x ∈ S, ∀ ε : Fin t → Bool, x + (∑ i : Fin t, if ε i then s i else 0) ∈ S₀) ∧
          (if t = 0 then (d : ℚ) / cubeDenom M₁ 0 ≤ (S.card : ℚ)
           else (d : ℚ) / cubeDenom M₁ t - (Q : ℚ) / 2 ≤ (S.card : ℚ)) := by
      intro t
      induction t with
      | zero =>
          intro _
          refine ⟨Fin.elim0, S₀, hS₀sub, fun i => Fin.elim0 i, ?_, ?_⟩
          · intro x hx _
            simpa using hx
          · simp only [↓reduceIte, cubeDenom_zero]
            rw [div_le_iff₀ (by exact_mod_cast (show 0 < M₁ by omega))]
            have hq : (d : ℚ) ≤ (M₁ : ℚ) * (S₀.card : ℚ) := by exact_mod_cast hN₀
            linarith
      | succ t ih =>
          intro ht1
          obtain ⟨s, S, hSsub, hsBnd, hCube, hCard⟩ := ih (by omega)
          obtain ⟨s_next, hs_next, hstepNat⟩ := cs_step hQpos hQL hSsub
          let S' := S.filter (fun x => x + s_next ∈ S)
          refine ⟨Fin.snoc s s_next, S', le_trans (Finset.filter_subset _ _) hSsub, ?_, ?_, ?_⟩
          · intro i
            refine Fin.lastCases ?_ ?_ i
            · simpa using hs_next
            · intro j; simpa using hsBnd j
          · intro x hx ε
            simp only [S', Finset.mem_filter] at hx
            rw [Fin.sum_univ_castSucc]
            simp only [Fin.snoc_castSucc, Fin.snoc_last]
            cases ε (Fin.last t)
            · simpa [add_assoc] using hCube x hx.1 (fun j => ε j.castSucc)
            · simp only [↓reduceIte]
              have hcomm :
                  x + ((∑ i : Fin t, if ε i.castSucc then s i else 0) + s_next) =
                  (x + s_next) + ∑ i : Fin t, if ε i.castSucc then s i else 0 := by ring
              rw [hcomm]
              exact hCube (x + s_next) hx.2 (fun j => ε j.castSucc)
          · simp only [Nat.succ_ne_zero, ↓reduceIte]
            have hdpos : (0 : ℚ) < (d : ℚ) := by exact_mod_cast (show 0 < d by omega)
            by_cases ht0 : t = 0
            · subst ht0
              simp only [↓reduceIte, cubeDenom_zero] at hCard
              have hdQ : (4 : ℚ) * (Q : ℚ) < (d : ℚ) / (M₁ : ℚ) := by
                rw [lt_div_iff₀ (by exact_mod_cast (show 0 < M₁ by omega))]
                have h8 : 4 * Q * M₁ < d := by dsimp [Q]; nlinarith
                exact_mod_cast h8
              have hSgtQ : Q ≤ S.card := by
                have hq : (Q : ℚ) < (S.card : ℚ) := by
                  have hQpos' : (0 : ℚ) < (Q : ℚ) := by exact_mod_cast hQpos
                  linarith
                exact_mod_cast le_of_lt hq
              have hstepQ : ((S.card : ℚ) * ((S.card : ℚ) - (Q : ℚ))) ≤
                  2 * (d : ℚ) * (S'.card : ℚ) := by
                have hcast : ((S.card * (S.card - Q) : ℕ) : ℚ) ≤
                    ((2 * d * S'.card : ℕ) : ℚ) := by exact_mod_cast hstepNat
                simpa [Nat.cast_sub hSgtQ] using hcast
              have hquad :
                  ((d : ℚ) / (M₁ : ℚ)) * ((d : ℚ) / (M₁ : ℚ) - (Q : ℚ)) ≤
                    (S.card : ℚ) * ((S.card : ℚ) - (Q : ℚ)) := by
                have hpos2 : 0 ≤ (d : ℚ) / (M₁ : ℚ) - (Q : ℚ) := by
                  have hQpos' : (0 : ℚ) < (Q : ℚ) := by exact_mod_cast hQpos
                  linarith
                nlinarith
              rw [cubeDenom_succ, cubeDenom_zero]
              have hM₁ge1 : (1 : ℚ) ≤ (M₁ : ℚ) := by exact_mod_cast hM₁
              have hM₁pos : (0 : ℚ) < (M₁ : ℚ) := by linarith
              have hdiv :
                  ((d : ℚ) / (2 * (M₁ : ℚ) ^ 2) - (Q : ℚ) / 2) * (2 * (d : ℚ)) ≤
                  ((d : ℚ) / (M₁ : ℚ)) * ((d : ℚ) / (M₁ : ℚ) - (Q : ℚ)) := by
                have hQd : (Q : ℚ) / (2 * (M₁ : ℚ)) ≤ (Q : ℚ) / 2 := by
                  apply div_le_div_of_nonneg_left (by positivity) (by norm_num) (by linarith)
                have hid :
                    ((d : ℚ) / (2 * (M₁ : ℚ) ^ 2) - (Q : ℚ) / (2 * (M₁ : ℚ))) * (2 * (d : ℚ)) =
                    ((d : ℚ) / (M₁ : ℚ)) * ((d : ℚ) / (M₁ : ℚ) - (Q : ℚ)) := by
                  field_simp
                nlinarith
              nlinarith
            · simp only [ht0, ↓reduceIte] at hCard
              have hBt_le : cubeDenom M₁ t ≤ cubeDenom M₁ (M₂ - 1) :=
                cubeDenom_mono hM₁ (by omega)
              have hXgt : (3 : ℚ) * (Q : ℚ) / 2 < (d : ℚ) / cubeDenom M₁ t := by
                have hle_div : (d : ℚ) / cubeDenom M₁ (M₂ - 1) ≤ (d : ℚ) / cubeDenom M₁ t :=
                  div_le_div_of_nonneg_left (le_of_lt hdpos) (cubeDenom_pos hM₁ t) hBt_le
                exact lt_of_lt_of_le hEnd hle_div
              have hSgtQ : Q ≤ S.card := by
                have hq : (Q : ℚ) < (S.card : ℚ) := by linarith
                exact_mod_cast le_of_lt hq
              have hstepQ : ((S.card : ℚ) * ((S.card : ℚ) - (Q : ℚ))) ≤
                  2 * (d : ℚ) * (S'.card : ℚ) := by
                have hcast : ((S.card * (S.card - Q) : ℕ) : ℚ) ≤
                    ((2 * d * S'.card : ℕ) : ℚ) := by exact_mod_cast hstepNat
                simpa [Nat.cast_sub hSgtQ] using hcast
              set X := (d : ℚ) / cubeDenom M₁ t
              have hquad : (X - (Q : ℚ) / 2) * (X - 3 * (Q : ℚ) / 2) ≤
                  (S.card : ℚ) * ((S.card : ℚ) - (Q : ℚ)) := by
                nlinarith
              have hBt2 : (2 : ℚ) ≤ cubeDenom M₁ t := cubeDenom_ge_two hM₁ (by omega)
              have hBtPos : 0 < cubeDenom M₁ t := cubeDenom_pos hM₁ t
              rw [cubeDenom_succ]
              have hid1 : X ^ 2 = (d : ℚ) / (2 * cubeDenom M₁ t ^ 2) * (2 * (d : ℚ)) := by
                dsimp [X]; field_simp
              have hid2 : 2 * (Q : ℚ) * X = ((Q : ℚ) / cubeDenom M₁ t) * (2 * (d : ℚ)) := by
                dsimp [X]; field_simp
              have hQBt : (Q : ℚ) / cubeDenom M₁ t ≤ (Q : ℚ) / 2 :=
                div_le_div_of_nonneg_left (by positivity) (by norm_num) hBt2
              have hQsq : 0 ≤ 3 * (Q : ℚ) ^ 2 / 4 := by positivity
              have hexp :
                  (X - (Q : ℚ) / 2) * (X - 3 * (Q : ℚ) / 2) =
                  X ^ 2 - 2 * (Q : ℚ) * X + 3 * (Q : ℚ) ^ 2 / 4 := by ring
              nlinarith
    -- Instantiate `hexists` at `t = M₂ - 1`, then run one final `cs_step`!
    obtain ⟨s_init, S_pen, hSpenSub, hsInitBnd, hCubePen, hCardPen⟩ := hexists (M₂ - 1) le_rfl
    have hne0 : M₂ - 1 ≠ 0 := by omega
    simp only [hne0, ↓reduceIte] at hCardPen
    have hgtQ : Q < S_pen.card := by
      have hq : (Q : ℚ) < (S_pen.card : ℚ) := by linarith
      exact_mod_cast hq
    obtain ⟨s_last, hs_last, hstepLast⟩ := cs_step hQpos hQL hSpenSub
    let S_fin := S_pen.filter (fun x => x + s_last ∈ S_pen)
    have hposFin : 0 < S_fin.card := by
      have hposLhs : 0 < S_pen.card * (S_pen.card - Q) := Nat.mul_pos (by omega) (by omega)
      change S_pen.card * (S_pen.card - Q) ≤ 2 * d * S_fin.card at hstepLast
      by_contra h0
      have h0' : S_fin.card = 0 := by omega
      rw [h0', mul_zero] at hstepLast
      omega
    obtain ⟨x₀, hx₀⟩ := Finset.card_pos.mp hposFin
    simp only [S_fin, Finset.mem_filter] at hx₀
    have hM₂eq : (M₂ - 1) + 1 = M₂ := by omega
    let s_all : Fin ((M₂ - 1) + 1) → ℕ := Fin.snoc s_init s_last
    refine ⟨(x₀ : ZMod d), s_all ∘ Fin.cast hM₂eq.symm, ?_, ?_⟩
    · intro t
      simp only [Function.comp_apply]
      refine Fin.lastCases ?_ ?_ (Fin.cast hM₂eq.symm t)
      · simpa [s_all, L₀, Q] using hs_last
      · intro j; simpa [s_all, L₀, Q] using hsInitBnd j
    · intro ε
      let ε' : Fin ((M₂ - 1) + 1) → Bool := ε ∘ Fin.cast hM₂eq
      have hsumEq :
          (∑ t : Fin M₂, if ε t then ((s_all (Fin.cast hM₂eq.symm t) : ℕ) : ZMod d) else 0) =
          ((∑ i : Fin ((M₂ - 1) + 1), if ε' i then s_all i else 0 : ℕ) : ZMod d) := by
        rw [Nat.cast_sum]
        refine Fintype.sum_equiv (Fin.castOrderIso hM₂eq.symm).toEquiv _ _ fun t => ?_
        cases hεt : ε t <;> simp [ε', Fin.castOrderIso, hεt]
      have hxIn : x₀ + (∑ i : Fin ((M₂ - 1) + 1), if ε' i then s_all i else 0) ∈ S₀ := by
        rw [Fin.sum_univ_castSucc]
        simp only [s_all, Fin.snoc_castSucc, Fin.snoc_last]
        cases ε' (Fin.last (M₂ - 1))
        · simpa [add_assoc] using hCubePen x₀ hx₀.1 (fun j => ε' j.castSucc)
        · simp only [↓reduceIte]
          have hcomm :
              x₀ + ((∑ i : Fin (M₂ - 1), if ε' i.castSucc then s_init i else 0) + s_last) =
              (x₀ + s_last) + ∑ i : Fin (M₂ - 1), if ε' i.castSucc then s_init i else 0 := by ring
          rw [hcomm]
          exact hCubePen (x₀ + s_last) hx₀.2 (fun j => ε' j.castSucc)
      have hx0In : x₀ ∈ S₀ := by
        simpa using hCubePen x₀ hx₀.1 (fun _ => false)
      simp only [S₀, C, Finset.mem_filter] at hxIn hx0In
      dsimp only [Function.comp_apply]
      rw [hsumEq]
      have hcast :
          (x₀ : ZMod d) + ((∑ i : Fin ((M₂ - 1) + 1), if ε' i then s_all i else 0 : ℕ) : ZMod d) =
          ((x₀ + ∑ i : Fin ((M₂ - 1) + 1), if ε' i then s_all i else 0 : ℕ) : ZMod d) := by
        push_cast; rfl
      rw [hcast, hxIn.2, hx0In.2]

end CauchySchwarzCube

/-! ### 5. Theorem 2A: Hales–Jewett-Free Two-Stage Exact Factorization Cutoff -/

section Theorem2A

private theorem orderedCubeMap_rowClassRotation {F A κ : Type*}
    [Field F] [AddCommGroup A] [Module F A] {d : ℕ}
    (p : ZMod d → κ) :
    ∀ {k : ℕ} (s : Fin k → ℕ) (ε : Fin k → Bool)
      (X : SharedDecoders.rowClassSpace (F := F) (A := A) p),
      (orderedCubeMap (fun t => SharedDecoders.rowClassRotation (F := F) (A := A) p (s t : ZMod d)) ε X).1 =
        rot (∑ t : Fin k, if ε t then (s t : ZMod d) else 0) X.1
  | 0, _, _, _ => by
      simp [orderedCubeMap]
  | k + 1, s, ε, X => by
      rw [Fin.sum_univ_castSucc]
      simp only [orderedCubeMap]
      have ih := orderedCubeMap_rowClassRotation p
        (fun i : Fin k => s i.castSucc) (fun i : Fin k => ε i.castSucc) X
      cases ε (Fin.last k)
      · simpa using ih
      · simp only [↓reduceIte, LinearMap.comp_apply, SharedDecoders.rowClassRotation_apply, ih,
          rot_rot, add_comm]

private theorem orderedCubeMap_all_false {F V : Type*}
    [Semiring F] [AddCommMonoid V] [Module F V] :
    ∀ {k : ℕ} (R : Fin k → (V →ₗ[F] V)),
      orderedCubeMap R (fun _ => false) = LinearMap.id
  | 0, _ => rfl
  | k + 1, R => by
      simp only [orderedCubeMap]
      exact orderedCubeMap_all_false (fun i : Fin k => R i.castSucc)

theorem theorem2A_TwoStageRamseyFreeCutoff : Theorem2A_TwoStageRamseyFreeCutoffSpec := by
  intro F _ d b M₁ M₂ _ p₁ p₂ K₁ K₂ hb hM₁ hM₂ h₁u h₂u hcomp
  by_contra hlt
  have hlt' : max (8 * M₁ * M₂ ^ 2) ((2 * M₁) ^ (2 ^ M₂)) < d := Nat.lt_of_not_ge hlt
  obtain ⟨c₀, s, hsBnd, hmono⟩ := cauchySchwarzAffineCubeExtraction d M₁ M₂ p₁ hM₁ hM₂ hlt'
  have h₁ : SharedDecoders.LinearClassUniform p₁ K₁ :=
    SharedDecoders.linearClassUniform_of_classUniform p₁ K₁ h₁u
  have h₂ : SharedDecoders.LinearClassUniform p₂ K₂ :=
    SharedDecoders.linearClassUniform_of_classUniform p₂ K₂ h₂u
  obtain ⟨f₁, hf₁⟩ := h₁
  obtain ⟨f₂, hf₂⟩ := h₂
  have hexact : ∀ X, K₂ (K₁ X) = swap X := fun X => by
    have h := LinearMap.congr_fun hcomp X
    exact h
  let A := Fin b → F
  let E₀ : (ZMod d → A) →ₗ[F] State d A :=
    (swapLinear F).comp (K₂.comp SharedDecoders.repeatColumns)
  have hE₀ : ∀ a, E₀ a ∈ SharedDecoders.rowClassSpace (F := F) (A := A) p₂ := by
    intro a i j hij
    funext c
    change K₂ (SharedDecoders.repeatColumns (F := F) a) c i =
      K₂ (SharedDecoders.repeatColumns (F := F) a) c j
    rw [hf₂, hf₂, hij, SharedDecoders.rot_repeatColumns, SharedDecoders.rot_repeatColumns]
  let E := E₀.codRestrict (SharedDecoders.rowClassSpace (F := F) (A := A) p₂) hE₀
  have hleft (a : ZMod d → A) : K₁ (E a).1 = SharedDecoders.repeatColumns (F := F) a :=
    SharedDecoders.first_swap_second K₁ K₂ hexact _
  have hEinj : Function.Injective E := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    have h : SharedDecoders.repeatColumns (F := F) a = 0 := by
      rw [← hleft a, ha]
      exact map_zero K₁
    funext i
    exact congrFun (congrFun h i) 0
  let W := LinearMap.range E
  let R : Fin M₂ →
      (SharedDecoders.rowClassSpace (F := F) (A := A) p₂ →ₗ[F]
        SharedDecoders.rowClassSpace (F := F) (A := A) p₂) :=
    fun t => SharedDecoders.rowClassRotation (F := F) (A := A) p₂ (s t : ZMod d)
  let L : SharedDecoders.rowClassSpace (F := F) (A := A) p₂ →ₗ[F] (ZMod d → A) :=
    (f₁ (p₁ c₀)).comp ((rotLinear F c₀).comp (SharedDecoders.rowClassSpace p₂).subtype)
  have hobs : ∀ (ε : Fin M₂ → Bool) (a : ZMod d → A),
      L (orderedCubeMap R ε (E a)) = a := by
    intro ε a
    funext i
    change f₁ (p₁ c₀) (rot c₀ ((orderedCubeMap R ε (E a)).1)) i = a i
    rw [orderedCubeMap_rowClassRotation, rot_rot]
    let cε := c₀ + ∑ t : Fin M₂, if ε t then (s t : ZMod d) else 0
    have h := hf₁ (E a).1 cε i
    rw [hmono ε] at h
    rw [← h, hleft]
    rfl
  have hobs0 : ∀ a : ZMod d → A, L (E a) = a := by
    intro a
    have h := hobs (fun _ => false) a
    rwa [orderedCubeMap_all_false, LinearMap.id_apply] at h
  have hdimA : finrank F A = b := by
    simp [A]
  have hdimW : finrank F W = d * b := by
    rw [LinearMap.finrank_range_of_inj hEinj]
    simp [Module.finrank_pi_fintype, ZMod.card, hdimA]
  have hker : ∀ x ∈ W, L x = 0 → x = 0 := by
    rintro x ⟨a, rfl⟩ hx
    have ha : a = 0 := (hobs0 a).symm.trans hx
    simp [ha]
  have hmsg : ∀ x ∈ W, ∀ ε : Fin M₂ → Bool, L (orderedCubeMap R ε x) = L x := by
    rintro x ⟨a, rfl⟩ ε
    exact (hobs ε a).trans (hobs0 a).symm
  have hg := lemma_AffineCubeCommonMessageGrowth F
    (SharedDecoders.rowClassSpace (F := F) (A := A) p₂) (ZMod d → A) M₂ R W L hker hmsg
  rw [hdimW] at hg
  have ha := SharedDecoders.rowClassSpace_finrank_le (F := F) (A := A) p₂
  simp only [Fintype.card_fin, hdimA] at ha
  have hsumKer :
      (∑ t : Fin M₂, finrank F (LinearMap.ker (R t - LinearMap.id))) ≤
        M₂ * (M₂ * (d / (2 * M₂ ^ 2)) * b) := by
    calc
      ∑ t : Fin M₂, finrank F (LinearMap.ker (R t - LinearMap.id))
        ≤ ∑ t : Fin M₂, (M₂ * s t * b) := by
          refine Finset.sum_le_sum fun t _ => ?_
          have hst : 0 < s t := by have := (hsBnd t).1; omega
          have h := SharedDecoders.rowClassRotation_fixed_finrank_le (F := F) (A := A) p₂ hst
          simpa [R, Fintype.card_fin, hdimA] using h
      _ ≤ ∑ _ : Fin M₂, (M₂ * (d / (2 * M₂ ^ 2)) * b) := by
          refine Finset.sum_le_sum fun t _ => ?_
          exact Nat.mul_le_mul_right b (Nat.mul_le_mul_left M₂ (hsBnd t).2)
      _ = M₂ * (M₂ * (d / (2 * M₂ ^ 2)) * b) := by simp
  have hcomb : ((M₂ + 1) * d) * b ≤ (M₂ * d + M₂ ^ 2 * (d / (2 * M₂ ^ 2))) * b := by
    have h1 := le_trans hg (Nat.add_le_add ha hsumKer)
    have hr1 : (M₂ + 1) * (d * b) = ((M₂ + 1) * d) * b := by ring
    have hr2 : M₂ * d * b + M₂ * (M₂ * (d / (2 * M₂ ^ 2)) * b) =
        (M₂ * d + M₂ ^ 2 * (d / (2 * M₂ ^ 2))) * b := by ring
    omega
  have hd_ineq : (M₂ + 1) * d ≤ M₂ * d + M₂ ^ 2 * (d / (2 * M₂ ^ 2)) :=
    Nat.le_of_mul_le_mul_right hcomb (by omega)
  have hdiv_le : 2 * M₂ ^ 2 * (d / (2 * M₂ ^ 2)) ≤ d := Nat.mul_div_le d (2 * M₂ ^ 2)
  have hd_pos : 0 < d := NeZero.pos d
  nlinarith

end Theorem2A

end BoundedArityDecoders
