import SharedDecoders.CapacitySetOrbit
import SharedDecoders.CapacityRunsOrbits
import SharedDecoders.CompositionAgreementCounting
import Mathlib.Algebra.Ring.Periodic

/-! # Exact fixed-shift counts and cyclic set-capacity estimates -/

namespace SharedDecoders.SetCapacity

open scoped BigOperators
attribute [local instance] Classical.propDecidable
attribute [local instance] rotationAction

variable {d : ℕ} [NeZero d] {A : Type*}

/-- A periodic word is exactly an arbitrary word on the actual translation quotient. -/
def periodicWordEquiv (s : ZMod d) :
    {f : ZMod d → A // Function.Periodic f s} ≃ (CapacityRuns.TranslationOrbit s → A) where
  toFun f := f.property.lift
  invFun f := ⟨fun x => f (x : CapacityRuns.TranslationOrbit s), by
    intro x
    apply congrArg f
    apply QuotientAddGroup.eq_iff_sub_mem.mpr
    simp⟩
  left_inv _ := rfl
  right_inv f := by
    funext o
    induction o using Quotient.inductionOn'
    rfl

def fixedHRowsEquiv (s : ZMod d) :
    {X : State d A // s ∈ H X} ≃
      (ZMod d → {f : ZMod d → A // Function.Periodic f s}) where
  toFun X c := ⟨X.val c, fun j => congrFun (congrFun ((mem_H _ _).mp X.property) c) j⟩
  invFun f := ⟨fun c => (f c).val, (mem_H _ _).mpr (funext (fun c => funext (f c).property))⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- The fixed-column-shift count uses the proved gcd count of translation orbits. -/
theorem fixed_H_card [Fintype A] (s : ZMod d) :
    Nat.card {X : State d A // s ∈ H X} = Fintype.card A ^ (d * Nat.gcd d s.val) := by
  rw [Nat.card_congr (fixedHRowsEquiv (A := A) s), Nat.card_fun,
    Nat.card_congr (periodicWordEquiv (A := A) s), Nat.card_fun]
  simp only [Nat.card_eq_fintype_card, ZMod.card, CapacityRuns.translationOrbit_card, ← pow_mul]
  rw [Nat.mul_comm]

/-- Twisting rows and transposing conjugates row covariance to ordinary column periods. -/
def covarianceConjugacy : State d A ≃ State d A := twistedRowsEquiv.trans swapEquiv

omit [NeZero d] in
theorem mem_K_iff_conjugate_H (X : State d A) (s : ZMod d) :
    s ∈ K X ↔ s ∈ H (covarianceConjugacy X) := by
  rw [mem_K, mem_H]
  constructor
  · intro h
    funext i c
    change X (c + s) (i - (c + s)) = X c (i - c)
    have he : i - (c + s) + s = i - c := by abel
    simpa only [he] using h c (i - (c + s))
  · intro h c j
    have hh := congrFun (congrFun h (j + c + s)) c
    change X (c + s) (j + c + s - (c + s)) = X c (j + c + s - c) at hh
    have h1 : j + c + s - (c + s) = j := by abel
    have h2 : j + c + s - c = j + s := by abel
    simpa only [h1, h2] using hh

theorem fixed_K_card [Fintype A] (s : ZMod d) :
    Nat.card {X : State d A // s ∈ K X} = Fintype.card A ^ (d * Nat.gcd d s.val) := by
  rw [Nat.card_congr (covarianceConjugacy.subtypeEquiv
    (p := fun X : State d A => s ∈ K X)
    (q := fun X : State d A => s ∈ H X) (fun X => mem_K_iff_conjugate_H X s))]
  exact fixed_H_card s

/-- In the cyclic group generated by one, containing one is exactly fullness. -/
theorem subgroup_eq_top_iff_one_mem (S : AddSubgroup (ZMod d)) : S = ⊤ ↔ (1 : ZMod d) ∈ S := by
  constructor
  · rintro rfl; trivial
  · intro h
    apply top_unique
    intro x _
    have hx := S.nsmul_mem h x.val
    simpa using hx

theorem full_H_card [Fintype A] :
    Nat.card {X : State d A // H X = ⊤} = Fintype.card A ^ d := by
  have he : {X : State d A // H X = ⊤} ≃ {X : State d A // (1 : ZMod d) ∈ H X} :=
    Equiv.subtypeEquivRight (fun X => subgroup_eq_top_iff_one_mem (H X))
  rw [Nat.card_congr he, fixed_H_card]
  by_cases hd : d = 1
  · subst d; simp
  · have : Fact (1 < d) := ⟨by have := NeZero.pos d; omega⟩
    rw [ZMod.val_one d]
    simp

theorem full_K_card [Fintype A] :
    Nat.card {X : State d A // K X = ⊤} = Fintype.card A ^ d := by
  have he : {X : State d A // K X = ⊤} ≃ {X : State d A // (1 : ZMod d) ∈ K X} :=
    Equiv.subtypeEquivRight (fun X => subgroup_eq_top_iff_one_mem (K X))
  rw [Nat.card_congr he, fixed_K_card]
  by_cases hd : d = 1
  · subst d; simp
  · have : Fact (1 < d) := ⟨by have := NeZero.pos d; omega⟩
    rw [ZMod.val_one d]
    simp

/-- Both subgroups are full exactly for the globally constant matrices. -/
def bothFullEquiv : {X : State d A // H X = ⊤ ∧ K X = ⊤} ≃ A where
  toFun X := X.val 0 0
  invFun a := ⟨fun _ _ => a, by
    constructor <;> apply top_unique <;> intro s _
    · exact (mem_H _ _).mpr rfl
    · exact fun _ _ => rfl⟩
  left_inv X := by
    apply Subtype.ext
    funext c j
    have hh : j ∈ H X.val := by rw [X.property.1]; trivial
    have hk : c ∈ K X.val := by rw [X.property.2]; trivial
    have hrow : X.val c j = X.val c 0 := by
      simpa only [rot_apply, zero_add] using congrFun (congrFun ((mem_H _ _).mp hh) c) 0
    have hcol : X.val c 0 = X.val 0 c := by simpa only [zero_add] using hk 0 0
    have hh' : c ∈ H X.val := by rw [X.property.1]; trivial
    have hz : X.val 0 c = X.val 0 0 := by
      simpa only [rot_apply, zero_add] using congrFun (congrFun ((mem_H _ _).mp hh') 0) 0
    exact (hrow.trans (hcol.trans hz)).symm
  right_inv _ := rfl

omit [NeZero d] in
theorem both_full_card [Fintype A] :
    Nat.card {X : State d A // H X = ⊤ ∧ K X = ⊤} = Fintype.card A := by
  rw [Nat.card_congr bothFullEquiv, Nat.card_eq_fintype_card]

section Finite
variable [Fintype A]

/-- Indicator sums are counts of the actual property fibre. -/
theorem sum_indicator_card {T : Type*} [Fintype T] (p : T → Prop) [DecidablePred p] :
    (∑ x : T, if p x then 1 else 0) = Nat.card {x : T // p x} := by
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype, Finset.card_filter]

theorem state_card : Nat.card (State d A) = Fintype.card A ^ (d * d) := by
  simp [State, Nat.card_eq_fintype_card, ZMod.card, ← pow_mul]

omit [Fintype A] in
theorem prime_weight_identity (hd : d.Prime) (X : State d A) :
    weight X + (if H X = ⊤ then 1 else 0) =
      1 + (d - 1) * (if K X = ⊤ then 1 else 0) +
        (if H X = ⊤ ∧ K X = ⊤ then 1 else 0) := by
  have hd1 := hd.one_le
  have : Fact d.Prime := ⟨hd⟩
  have : Fact (Nat.card (ZMod d)).Prime := ⟨by simpa using hd⟩
  rcases (H X).eq_bot_or_eq_top_of_prime_card with hh | hh <;>
    rcases (K X).eq_bot_or_eq_top_of_prime_card with hk | hk <;>
    simp [weight, Eligible, hh, hk] <;> omega

/-- Exact prime-dimension count, derived from the four actual subgroup cases. -/
theorem prime_capacity_mul (hd : d.Prime) :
    d * capacity (d := d) (A := A) =
      Fintype.card A ^ (d * d) + (d - 2) * Fintype.card A ^ d + Fintype.card A := by
  have hs := Finset.sum_congr (s₁ := Finset.univ) (s₂ := Finset.univ) rfl
    (fun X _ => prime_weight_identity (A := A) hd X)
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum, sum_indicator_card,
    ← capacity_weighted_formula, full_H_card, full_K_card, both_full_card,
    Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_one] at hs
  have hc : Fintype.card (State d A) = Fintype.card A ^ (d * d) := by
    rw [← Nat.card_eq_fintype_card, state_card]
  rw [hc] at hs
  have hd' : d - 1 = (d - 2) + 1 := by have := hd.two_le; omega
  rw [hd', Nat.add_mul, one_mul] at hs
  omega

theorem prime_capacity (hd : d.Prime) :
    capacity (d := d) (A := A) =
      (Fintype.card A ^ (d * d) + (d - 2) * Fintype.card A ^ d + Fintype.card A) / d := by
  rw [← prime_capacity_mul hd, Nat.mul_div_cancel_left _ (NeZero.pos d)]

/-- Finite incidence counting, applied below to actual shift membership. -/
theorem sum_memberships {T I : Type*} [Fintype T] [Fintype I] (R : T → I → Prop) :
    (∑ x : T, Nat.card {i : I // R x i}) = ∑ i : I, Nat.card {x : T // R x i} := by
  let e : (Σ x : T, {i : I // R x i}) ≃ (Σ i : I, {x : T // R x i}) := {
    toFun := fun x => ⟨x.2.val, ⟨x.1, x.2.property⟩⟩
    invFun := fun x => ⟨x.2.val, ⟨x.1, x.2.property⟩⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl }
  simpa only [Nat.card_sigma] using Nat.card_congr e

noncomputable def errorSum : ℕ :=
  ∑ s ∈ (Finset.univ : Finset (ZMod d)).erase 0,
    Fintype.card A ^ (d * Nat.gcd d s.val)

theorem sum_K_card : (∑ X : State d A, Nat.card (K X)) =
    Fintype.card A ^ (d * d) + errorSum (d := d) (A := A) := by
  change (∑ X : State d A, Nat.card {s : ZMod d // s ∈ K X}) = _
  rw [sum_memberships]
  simp_rw [fixed_K_card]
  rw [← Finset.sum_erase_add _ _ (Finset.mem_univ (0 : ZMod d))]
  simp [errorSum, Nat.add_comm]

theorem sum_nonzero_H_card :
    (∑ X : State d A, Nat.card {s : ZMod d // s ≠ 0 ∧ s ∈ H X}) =
      errorSum (d := d) (A := A) := by
  rw [sum_memberships]
  have h (s : ZMod d) : Nat.card {X : State d A // s ≠ 0 ∧ s ∈ H X} =
      if s = 0 then 0 else Fintype.card A ^ (d * Nat.gcd d s.val) := by
    by_cases hs : s = 0
    · simp [hs]
    · rw [ite_eq_right hs]
      have e : {X : State d A // s ≠ 0 ∧ s ∈ H X} ≃ {X : State d A // s ∈ H X} :=
        Equiv.subtypeEquivRight (fun _ => by simp [hs])
      rw [Nat.card_congr e, fixed_H_card]
  simp_rw [h]
  rw [← Finset.sum_erase_add _ _ (Finset.mem_univ (0 : ZMod d))]
  simp only [ite_true, add_zero]
  unfold errorSum
  apply Finset.sum_congr rfl
  intro s hs
  simp [Finset.ne_of_mem_erase hs]

omit [Fintype A] in
theorem one_le_weight_add_bad (X : State d A) :
    1 ≤ weight X + Nat.card {s : ZMod d // s ≠ 0 ∧ s ∈ H X} := by
  by_cases hx : Eligible X
  · have hp := Nat.card_pos (α := K X)
    simpa only [weight, ite_eq_left hx] using le_add_of_le_left hp
  · have hn : ∃ s, s ∈ H X ∧ s ∉ K X := by
      by_contra hn
      apply hx
      intro s hs
      by_contra hk
      exact hn ⟨s, hs, hk⟩
    obtain ⟨s, hsH, hsK⟩ := hn
    have hs0 : s ≠ 0 := by intro h; subst s; exact hsK (K X).zero_mem
    have : Nonempty {s : ZMod d // s ≠ 0 ∧ s ∈ H X} := ⟨⟨s, hs0, hsH⟩⟩
    have hp := Nat.card_pos (α := {s : ZMod d // s ≠ 0 ∧ s ∈ H X})
    exact le_add_of_le_right hp

/-- Union-bound lower estimate and incidence-count upper estimate, for every dimension. -/
theorem capacity_two_sided :
    Fintype.card A ^ (d * d) ≤ d * capacity (d := d) (A := A) + errorSum (d := d) (A := A) ∧
    d * capacity (d := d) (A := A) ≤ Fintype.card A ^ (d * d) + errorSum (d := d) (A := A) := by
  constructor
  · have hh := Finset.sum_le_sum (s := Finset.univ) (fun X : State d A => fun _ => one_le_weight_add_bad X)
    simpa only [Finset.sum_add_distrib, ← capacity_weighted_formula, sum_nonzero_H_card,
      Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_one,
      ← Nat.card_eq_fintype_card, state_card] using hh
  · rw [capacity_weighted_formula, ← sum_K_card]
    apply Finset.sum_le_sum
    intro X _
    unfold weight
    split_ifs <;> omega

/-- A nonzero residue has a proper gcd divisor, at most half the dimension. -/
theorem gcd_le_half (s : ZMod d) (hs : s ≠ 0) : Nat.gcd d s.val ≤ d / 2 := by
  have hsval : 0 < s.val := Nat.pos_of_ne_zero (fun h => hs (ZMod.val_injective d (by simpa using h)))
  have hgpos : 0 < Nat.gcd d s.val := Nat.gcd_pos_of_pos_left _ (NeZero.pos d)
  have hglt : Nat.gcd d s.val < d := lt_of_le_of_lt (Nat.gcd_le_right d hsval) (ZMod.val_lt s)
  obtain ⟨k, hk⟩ := Nat.gcd_dvd_left d s.val
  have hk2 : 2 ≤ k := by
    by_contra h
    have : k = 0 ∨ k = 1 := by omega
    rcases this with rfl | rfl
    · simp only [mul_zero] at hk; omega
    · simp only [mul_one] at hk; omega
  apply (Nat.le_div_iff_mul_le (by decide : 0 < 2)).mpr
  nlinarith

theorem errorSum_le (hA : 1 ≤ Fintype.card A) :
    errorSum (d := d) (A := A) ≤ (d - 1) * Fintype.card A ^ (d * (d / 2)) := by
  classical
  unfold errorSum
  calc
    (∑ s ∈ (Finset.univ : Finset (ZMod d)).erase 0,
        Fintype.card A ^ (d * Nat.gcd d s.val)) ≤
      ∑ _s ∈ (Finset.univ : Finset (ZMod d)).erase 0,
        Fintype.card A ^ (d * (d / 2)) := by
      apply Finset.sum_le_sum
      intro s hs
      exact Nat.pow_le_pow_right hA (Nat.mul_le_mul_left d (gcd_le_half s (Finset.ne_of_mem_erase hs)))
    _ = _ := by simp [ZMod.card]

end Finite
end SharedDecoders.SetCapacity
