import Mathlib.Data.ZMod.Defs

/-!
# Packed data for the ℓ = 11 Goren–Oort operator (generated by `tools/gen_operator.py`)

Do not edit by hand. Tables are packed into natural numbers (little-endian digits in base `2 ^ w`),
so that the kernel reads an entry with one division and one remainder on a literal.
* `edgeOfCode`: base `2⁷`, digit `11 a + b` is the edge joining even vertex `a` to odd vertex `b`
  (127: no edge). A cache: `ConCache.lean` proves it equal to the construction.
* `couplingCode`: base `2²`, digit `100 e + 10 a + b` is entry `(a, b)` of the 10 × 10 block of
  edge `e` over 𝔽₃. A cache: `ConCache.lean` proves it equal to the construction.
* `edgeGenCode`: base `2⁷`, digit `e` is the free generator of edge `e` (127: spanning-tree edge).
  A choice: `ConChecks.lean` checks that the tree edges form a spanning tree.
* `voltCode`: base `2²`, the 3-cover voltage of each generator (a choice).
The certificate data are in `CertData.lean`, checked in `CertB0.lean`, `CertB1.lean` and `CertRest.lean`.
-/

namespace Luck.Data

/-- Digit `k` of `n` in base `2 ^ w`. -/
def digit (w n k : ℕ) : ℕ := n / 2 ^ (w * k) % 2 ^ w

def edgeOfCode : ℕ := 0xa885191eb3b5fa8a3fff89864969bb1adf24a13ff888441998c5a5eab4f3bf879839720c39de3b4737f869631a1dc1971ba555ff85945579abf7b6394d5bf84924da973f775384557f83904583639734375353f828e3c6b1336f3414b4ff818d145ac2d6b240434bf80

def edgeGenCode : ℕ := 0x2c57ad56a53a547fffa13e74dff325ca93fe4478d1624385fe0ff80fdf3d78edd39fffffff70ddb7f6ad19ff64c582f5cb562b54a547f4e992fffe911a24280f9e3a73f9b3464c172c54a13fffc911203c70dfe3058afe244070c14203040407f

def couplingCode : ℕ :=
  

def voltCode : ℕ := 0x124a51661a5950582248a8508125240926a054860a0a5

def edgeOfNat (a b : ℕ) : ℕ := digit 7 edgeOfCode (11 * a + b)

def edgeGenNat (e : ℕ) : ℕ := digit 7 edgeGenCode e

def couplingNat (e a b : ℕ) : ℕ := digit 2 couplingCode (100 * e + 10 * a + b)

def voltNat (g : ℕ) : ℕ := digit 2 voltCode g

/-- The free generator of an edge (`none` on the 21 spanning-tree edges). -/
def edgeGen (e : Fin 110) : Option (Fin 89) :=
  if h : edgeGenNat e < 89 then some ⟨_, h⟩ else none

/-- The 3-cover voltage of a generator. -/
def volt (g : Fin 89) : ZMod 3 := (voltNat g : ZMod 3)

end Luck.Data
