import BitWord.CanonicalMetadata
import BitWord.NativeBindingCalls
import TransposeFollowup.NativeBatchErase

/-! Fixed large-branch arithmetic for the canonical gate recipe. The input h
word is generated by the paid entry-width loader in the enclosing caller. -/
namespace BitWord.NativeCanonicalParameters
open FixedTapeCompiler CopyMachine TransposeFollowup
open NativeBankCalls NativeExpanderShearFrames
set_option autoImplicit false

inductive Port | h | u | tmpA | tmpB | base | wide | zero | inc | half | double | total | diff
  deriving DecidableEq
instance : Fintype Port where
  elems := {.h,.u,.tmpA,.tmpB,.base,.wide,.zero,.inc,.half,.double,.total,.diff}
  complete := by intro p; cases p <;> simp
abbrev Bank := Port → Tape Bool

inductive Op | increment | double | total | diff
  deriving DecidableEq
instance : Fintype Op where
  elems := {.increment,.double,.total,.diff}
  complete := by intro p; cases p <;> simp

def output : Op → Port
  | .increment => .inc | .double => .double | .total => .total | .diff => .diff

def operands : Op → Fin 3 → Port
  | .increment => ![.wide,.zero,.inc]
  | .double => ![.inc,.half,.double]
  | .total => ![.base,.half,.total]
  | .diff => ![.base,.half,.diff]

def carryBinding (o : Op) : FinitePortBinding (Fin 3) Port where
  ports := ⟨operands o,by cases o <;> decide +kernel⟩
  decode := fun p => if p=operands o 0 then some 0 else if p=operands o 1 then some 1
    else if p=operands o 2 then some 2 else none
  decode_spec := by intro p i; cases o <;> cases p <;> fin_cases i <;> decide +kernel

def entryBinding : FinitePortBinding (Fin 4) Port where
  ports := ⟨![.h,.tmpA,.tmpB,.u],by decide +kernel⟩
  decode := fun p => match p with | .h => some 0 | .tmpA => some 1 | .tmpB => some 2 | .u => some 3 | _ => none
  decode_spec := by intro p i; cases p <;> fin_cases i <;> decide +kernel

def padPorts (second : Bool) : Fin 3 → Port := if second then ![.u,.h,.wide] else ![.h,.u,.base]
def padBinding (second : Bool) : FinitePortBinding (Fin 3) Port where
  ports := ⟨padPorts second,by cases second <;> decide +kernel⟩
  decode := fun p => if p=padPorts second 0 then some 0 else if p=padPorts second 1 then some 1
    else if p=padPorts second 2 then some 2 else none
  decode_spec := by intro p i; cases second <;> cases p <;> fin_cases i <;> decide +kernel

def padding (second : Bool) : ℕ := if second then 3 else 2

def copyBinding (second : Bool) :=
  pairBinding (if second then Port.inc else .wide) (if second then Port.half else .zero)
    (by cases second <;> decide)
def copyMap (second : Bool) : Bool → Bool := if second then id else fun _ => false

def erasePorts : Fin 4 ↪ Port := ⟨![.base,.wide,.zero,.half],by decide +kernel⟩
def allBinding : FinitePortBinding Port Port where
  ports := Function.Embedding.refl _
  decode := some
  decode_spec := by intro p q; simp [eq_comm]

inductive Label
  | entry (pc : EntryBits.Label)
  | pad (second : Bool) (pc : NativeCrossPad.Label (padding second))
  | copy (second : Bool) (pc : NativeMappedCopy.Label)
  | init (op : Op) (pc : NativeBuffer.Label)
  | arithmetic (op : Op) (pc : BinaryCarry.Label)
  | halve (pc : NativeExpanderShearHalf.Label)
  | eraseInc (pc : NativeErase.Label)
  | resetInc
  | erase (pc : NativeBatchErase.Label 4)
  | done
  deriving DecidableEq, Fintype

def sub (o : Op) : Bool := decide (o=.diff)
def carry (o : Op) : Bool := decide (o=.increment ∨ o=.diff)
def after : Op → Label
  | .increment => .halve .left
  | .double => .init .total (.erase 0)
  | .total => .init .diff (.erase 0)
  | .diff => .eraseInc 2

def start : Label := .entry EntryBits.start

def program : Microcode.Program Port Label
  | .entry .done => .jump (.pad false (NativeCrossPad.start 2))
  | .entry pc => entryBinding.instruction Label.entry (EntryBits.program pc)
  | .pad false (.tail (.seal .done)) => .jump (.pad true (NativeCrossPad.start 3))
  | .pad true (.tail (.seal .done)) => .jump (.copy false (.init (.erase 0)))
  | .pad s pc => (padBinding s).instruction (Label.pad s) (NativeCrossPad.program (padding s) pc)
  | .copy s (.seal .done) => .jump (.init (if s then .double else .increment) (.erase 0))
  | .copy s pc => (copyBinding s).instruction (Label.copy s) (NativeMappedCopy.program (copyMap s) pc)
  | .init o .done => .jump (.arithmetic o (.scan (sub o) (carry o)))
  | .init o pc => (singleBinding (output o)).instruction (Label.init o) (NativeBuffer.program pc)
  | .arithmetic o (.done _) => .jump (after o)
  | .arithmetic o pc => (carryBinding o).instruction (Label.arithmetic o) (BinaryCarry.program pc)
  | .halve .done => .jump (.copy true (.init (.erase 0)))
  | .halve pc => (singleBinding .inc).instruction Label.halve (NativeExpanderShearHalf.program pc)
  | .eraseInc pc => if pc=0 then .jump .resetInc
      else (singleBinding .inc).instruction Label.eraseInc (NativeErase.program pc)
  | .resetInc => .act (Microcode.single .inc ⟨none,.left⟩) (.erase (NativeBatchErase.entry 4 0))
  | .erase .done => .jump .done
  | .erase pc => allBinding.instruction Label.erase (NativeBatchErase.program erasePorts pc)
  | .done => .halt

abbrev cfg := workCfg (T:=Port) (L:=Label)
abbrev Trace := OperationalTrace.Trace (NativeMicrocode.step program) (NativeMicrocode.Active program)

def initial (h : ℕ) : Bank := fun p => if p=.h then Counter.marked (CanonicalMetadata.hword h) else ⟨[],[]⟩
def final (h : ℕ) : Bank
  | .h => Counter.marked (CanonicalMetadata.hword h)
  | .u => Counter.marked (CanonicalMetadata.uword h)
  | .double => Counter.marked (CanonicalMetadata.W h)
  | .total => Counter.marked (CanonicalMetadata.N h)
  | .diff => Counter.marked (CanonicalMetadata.R h)
  | _ => ⟨[],[]⟩

theorem entry_code (pc : EntryBits.Label) (hh : EntryBits.program pc ≠ .halt)
    (_ : EntryBits.program pc ≠ .reject) :
    program (.entry pc)=MicrocodeEmbedding.instruction entryBinding.ports Label.entry (EntryBits.program pc) := by
  cases pc <;> simp_all [program,EntryBits.program,FinitePortBinding.instruction_eq]

theorem pad_code (s : Bool) (pc : NativeCrossPad.Label (padding s))
    (hh : NativeCrossPad.program (padding s) pc ≠ .halt)
    (hr : NativeCrossPad.program (padding s) pc ≠ .reject) :
    program (.pad s pc)=MicrocodeEmbedding.instruction (padBinding s).ports (Label.pad s)
      (NativeCrossPad.program (padding s) pc) := by
  cases s <;> cases pc <;> try { exact (padBinding _).instruction_eq _ _ }
  all_goals rename_i pc; cases pc <;> try { exact (padBinding _).instruction_eq _ _ }
  all_goals rename_i pc; cases pc <;> simp_all [program,NativeCrossPad.program,
    PaddedWord.program,NativeSealBack.program,FinitePortBinding.instruction_eq,MicrocodeEmbedding.instruction]

theorem copy_code (s : Bool) (pc : NativeMappedCopy.Label)
    (hh : NativeMappedCopy.program (copyMap s) pc ≠ .halt)
    (hr : NativeMappedCopy.program (copyMap s) pc ≠ .reject) :
    program (.copy s pc)=MicrocodeEmbedding.instruction (copyBinding s).ports (Label.copy s)
      (NativeMappedCopy.program (copyMap s) pc) := by
  cases pc <;> try { exact (copyBinding s).instruction_eq _ _ }
  rename_i pc; cases pc <;> simp_all [program,NativeMappedCopy.program,
    NativeSealBack.program,FinitePortBinding.instruction_eq,MicrocodeEmbedding.instruction]

theorem init_code (o : Op) : NativeTapeCalls.Code program (output o) (Label.init o) NativeBuffer.program := by
  intro pc hh _; cases pc <;> simp_all [program,NativeBuffer.program,FinitePortBinding.instruction_eq]

theorem arithmetic_code (o : Op) (pc : BinaryCarry.Label)
    (hh : BinaryCarry.program pc ≠ .halt) (_ : BinaryCarry.program pc ≠ .reject) :
    program (.arithmetic o pc)=MicrocodeEmbedding.instruction (carryBinding o).ports
      (Label.arithmetic o) (BinaryCarry.program pc) := by
  cases pc <;> simp_all [program,BinaryCarry.program,FinitePortBinding.instruction_eq]

theorem half_code : NativeTapeCalls.Code program .inc Label.halve NativeExpanderShearHalf.program := by
  intro pc hh _; cases pc <;> simp_all [program,NativeExpanderShearHalf.program,FinitePortBinding.instruction_eq]

theorem eraseInc_code : NativeTapeCalls.Code program .inc Label.eraseInc NativeErase.program := by
  intro pc hh _
  have hp : pc ≠ 0 := by intro h; subst pc; exact hh rfl
  simp [program,hp,FinitePortBinding.instruction_eq]

theorem erase_code (pc : NativeBatchErase.Label 4)
    (hh : NativeBatchErase.program erasePorts pc ≠ .halt)
    (_ : NativeBatchErase.program erasePorts pc ≠ .reject) :
    program (.erase pc)=MicrocodeEmbedding.instruction allBinding.ports Label.erase
      (NativeBatchErase.program erasePorts pc) := by
  cases pc <;> simp_all [program,NativeBatchErase.program,FinitePortBinding.instruction_eq]

theorem jump (pc next : Label) (s : Bank) (pos : Port → ℤ)
    (h : program pc=.jump next) : Trace 1 (cfg pc s pos) (cfg next s pos) :=
  NativeMicrocode.jump_trace _ _ _ h

end BitWord.NativeCanonicalParameters
