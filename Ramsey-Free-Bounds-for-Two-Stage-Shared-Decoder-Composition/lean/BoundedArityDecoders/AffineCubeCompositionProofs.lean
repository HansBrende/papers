private def d13EEntry (ch : Fin 2) (u : ZMod 13) (j : Fin 9) : ℤ :=
  (d13ETable.getD (ch.val * 13 + u.val) #[]).getD j.val 0

private def d13L13Entry (i : Fin 9) (ch : Fin 2) (u : ZMod 13) : ℤ :=
  (d13L13Table.getD i.val #[]).getD (ch.val * 13 + u.val) 0

private theorem d13_int_ident :
    ∀ c ∈ ({0, 1, 4, 5} : Finset (ZMod 13)), ∀ i j : Fin 9,
      (∑ ch : Fin 2, ∑ u : ZMod 13, d13L13Entry i ch u * d13EEntry ch (u + c) j) =
        if i = j then 13 else 0 := by
  decide

@[simp]
private theorem cyclicChannelShift_apply {R : Type*} [Semiring R] {d q : ℕ}
    (s : ZMod d) (x : ZMod d → Fin q → R) (u : ZMod d) (ch : Fin q) :
    cyclicChannelShift R d q s x u ch = x (u + s) ch := rfl

private theorem cyclicChannelShift_zero (R : Type*) [Semiring R] (d q : ℕ) :
    cyclicChannelShift R d q 0 = LinearMap.id := by
  ext x u ch
  simp

private theorem cyclicChannelShift_comp (R : Type*) [Semiring R] (d q : ℕ) (s₁ s₂ : ZMod d) :
    (cyclicChannelShift R d q s₂).comp (cyclicChannelShift R d q s₁) =
      cyclicChannelShift R d q (s₁ + s₂) := by
  apply LinearMap.ext; intro x; funext u ch
  simp only [LinearMap.comp_apply, cyclicChannelShift_apply]
  congr 1; ring

private theorem cyclicChannelShift_ker_finrank_le {F : Type*} [Field F]
    (s inv : ZMod 13) (hinv : s * inv = 1) :
    finrank F (LinearMap.ker (cyclicChannelShift F 13 2 s - LinearMap.id)) ≤ 2 := by
  let eval0 : LinearMap.ker (cyclicChannelShift F 13 2 s - LinearMap.id) →ₗ[F] (Fin 2 → F) :=
    { toFun := fun x => x.1 0
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hinj : Function.Injective eval0 := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    change x.1 0 = 0 at hx
    have hper : ∀ u : ZMod 13, x.1 (u + s) = x.1 u := by
      intro u
      have h0 : ((cyclicChannelShift F 13 2 s - LinearMap.id) : _ →ₗ[F] _) x.1 = 0 :=
        LinearMap.mem_ker.mp x.2
      rw [LinearMap.sub_apply, LinearMap.id_apply, sub_eq_zero] at h0
      exact congrFun h0 u
    have hnat : ∀ n : ℕ, x.1 ((n : ZMod 13) * s) = 0 := by
      intro n
      induction n with
      | zero => simpa only [Nat.cast_zero, zero_mul] using hx
      | succ n ih =>
          have hstep : (((n + 1 : ℕ) : ZMod 13) * s) = (n : ZMod 13) * s + s := by
            push_cast; ring
          rw [hstep, hper, ih]
    apply Subtype.ext
    funext u
    have hu : (((u * inv).val : ℕ) : ZMod 13) * s = u := by
      rw [ZMod.natCast_zmod_val, mul_assoc, mul_comm inv s, hinv, mul_one]
    rw [← hu]
    exact hnat (u * inv).val
  have hle := LinearMap.finrank_le_finrank_of_injective hinj
  simpa [Module.finrank_pi] using hle

theorem control_D13TwoCubeAPFreeSharpness : Control_D13TwoCubeAPFreeSharpnessSpec := by
  dsimp only [Control_D13TwoCubeAPFreeSharpnessSpec]
  have h3ap : ThreeAPFreeMod ({0, 1, 4, 5} : Finset (ZMod 13)) := by
    unfold ThreeAPFreeMod; decide
  refine ⟨h3ap, ?_, ?_, ?_⟩
  · intro ℓ c₀ s hs hprog
    have hle : ℓ ≤ 2 := by
      by_contra hlt
      have h0 := hprog 0 (by omega)
      have h1 := hprog 1 (by omega)
      have h2 := hprog 2 (by omega)
      simp only [Nat.cast_zero, zero_mul, add_zero] at h0
      simp only [Nat.cast_one, one_mul] at h1
      have h2' : c₀ + (s + s) ∈ ({0, 1, 4, 5} : Finset (ZMod 13)) := by
        convert h2 using 2; ring
      exact h3ap c₀ s hs ⟨h0, h1, h2'⟩
    refine ⟨hle, fun h1 => ?_⟩
    rcases (show ℓ = 1 ∨ ℓ = 2 by omega) with rfl | rfl <;> decide
  · intro F Z _ _ _ W L hinj hmsg
    let R : Fin 2 → ((ZMod 13 → Fin 2 → F) →ₗ[F] (ZMod 13 → Fin 2 → F)) :=
      ![cyclicChannelShift F 13 2 1, cyclicChannelShift F 13 2 4]
    have hcube : ∀ x ∈ W, ∀ ε : Fin 2 → Bool, L (orderedCubeMap R ε x) = L x := by
      intro x hx ε
      have hε : ∃ c ∈ ({0, 1, 4, 5} : Finset (ZMod 13)),
          orderedCubeMap R ε = cyclicChannelShift F 13 2 c := by
        cases h0 : ε 0 <;> cases h1 : ε 1
        · refine ⟨0, by decide, ?_⟩
          simp [orderedCubeMap, h0, h1, cyclicChannelShift_zero]
        · refine ⟨4, by decide, ?_⟩
          simp [orderedCubeMap, R, h0, h1]
        · refine ⟨1, by decide, ?_⟩
          simp [orderedCubeMap, R, h0, h1]
        · refine ⟨5, by decide, ?_⟩
          simp only [orderedCubeMap, Fin.last]
          change (if ε 1 then (R 1).comp (if ε 0 then (R 0).comp LinearMap.id else LinearMap.id)
            else (if ε 0 then (R 0).comp LinearMap.id else LinearMap.id)) = _
          rw [h0, h1]
          simp only [↓reduceIte, LinearMap.comp_id, R, Matrix.cons_val_one, Matrix.cons_val_zero,
            cyclicChannelShift_comp]
          rfl
      obtain ⟨c, hc, hEq⟩ := hε
      rw [hEq]
      exact hmsg x hx c hc
    have hg := lemma_AffineCubeCommonMessageGrowth F (ZMod 13 → Fin 2 → F) Z 2 R W L hinj hcube
    have hdimA : finrank F (ZMod 13 → Fin 2 → F) = 26 := by
      simp [Module.finrank_pi_fintype, ZMod.card]
    have hk0 : finrank F (LinearMap.ker (R 0 - LinearMap.id)) ≤ 2 :=
      cyclicChannelShift_ker_finrank_le 1 1 (by decide)
    have hk1 : finrank F (LinearMap.ker (R 1 - LinearMap.id)) ≤ 2 :=
      cyclicChannelShift_ker_finrank_le 4 10 (by decide)
    rw [hdimA, Fin.sum_univ_two] at hg
    refine ⟨by omega, by omega⟩
  · let E_R : (Fin 9 → ℝ) →ₗ[ℝ] (ZMod 13 → Fin 2 → ℝ) :=
      { toFun := fun v u ch => ∑ j : Fin 9, (d13EEntry ch u j : ℝ) * v j
        map_add' := fun v w => by
          funext u ch; simp [mul_add, Finset.sum_add_distrib]
        map_smul' := fun r v => by
          funext u ch; simp [Finset.mul_sum, mul_left_comm] }
    let L_R : (ZMod 13 → Fin 2 → ℝ) →ₗ[ℝ] (Fin 9 → ℝ) :=
      { toFun := fun x i =>
          (1 / 13 : ℝ) * ∑ ch : Fin 2, ∑ u : ZMod 13, (d13L13Entry i ch u : ℝ) * x u ch
        map_add' := fun x y => by
          funext i; simp [mul_add, Finset.sum_add_distrib]
        map_smul' := fun r x => by
          funext i
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
          rw [← mul_assoc, mul_comm r (1 / 13 : ℝ), mul_assoc]
          congr 1
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun ch _ => ?_
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl fun u _ => by ring }
    have hLE : ∀ c ∈ ({0, 1, 4, 5} : Finset (ZMod 13)), ∀ v : Fin 9 → ℝ,
        L_R (cyclicChannelShift ℝ 13 2 c (E_R v)) = v := by
      intro c hc v
      funext i
      change (1 / 13 : ℝ) *
          ∑ ch : Fin 2, ∑ u : ZMod 13,
            (d13L13Entry i ch u : ℝ) * (∑ j : Fin 9, (d13EEntry ch (u + c) j : ℝ) * v j) = v i
      have hrew2 :
          (∑ ch : Fin 2, ∑ u : ZMod 13,
            (d13L13Entry i ch u : ℝ) * (∑ j : Fin 9, (d13EEntry ch (u + c) j : ℝ) * v j)) =
          ∑ j : Fin 9,
            ((∑ ch : Fin 2, ∑ u : ZMod 13,
              (d13L13Entry i ch u : ℝ) * (d13EEntry ch (u + c) j : ℝ)) * v j) := by
        calc
          _ = ∑ ch : Fin 2, ∑ u : ZMod 13, ∑ j : Fin 9,
                ((d13L13Entry i ch u : ℝ) * (d13EEntry ch (u + c) j : ℝ)) * v j := by
              refine Finset.sum_congr rfl fun ch _ => Finset.sum_congr rfl fun u _ => ?_
              rw [Finset.mul_sum]
              exact Finset.sum_congr rfl fun j _ => (mul_assoc _ _ _).symm
          _ = ∑ ch : Fin 2, ∑ j : Fin 9, ∑ u : ZMod 13,
                ((d13L13Entry i ch u : ℝ) * (d13EEntry ch (u + c) j : ℝ)) * v j := by
              exact Finset.sum_congr rfl fun ch _ => Finset.sum_comm
          _ = ∑ j : Fin 9, ∑ ch : Fin 2, ∑ u : ZMod 13,
                ((d13L13Entry i ch u : ℝ) * (d13EEntry ch (u + c) j : ℝ)) * v j := Finset.sum_comm
          _ = _ := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [Finset.sum_mul]
              exact Finset.sum_congr rfl fun ch _ => (Finset.sum_mul _ _ _).symm
      rw [hrew2]
      have hcoeff : ∀ j : Fin 9,
          (∑ ch : Fin 2, ∑ u : ZMod 13,
            (d13L13Entry i ch u : ℝ) * (d13EEntry ch (u + c) j : ℝ)) =
          if i = j then (13 : ℝ) else 0 := by
        intro j
        have hint := d13_int_ident c hc i j
        have hcast : ((∑ ch : Fin 2, ∑ u : ZMod 13,
            d13L13Entry i ch u * d13EEntry ch (u + c) j : ℤ) : ℝ) =
            ((if i = j then (13 : ℤ) else 0 : ℤ) : ℝ) := congrArg Int.cast hint
        simpa [Int.cast_sum, Int.cast_mul] using hcast
      simp_rw [hcoeff]
      simp [ite_mul]
    let W : Submodule ℝ (ZMod 13 → Fin 2 → ℝ) := LinearMap.range E_R
    have hL0 : ∀ v : Fin 9 → ℝ, L_R (E_R v) = v := by
      intro v
      have h0 := hLE 0 (by decide) v
      rwa [cyclicChannelShift_zero] at h0
    have hEinj : Function.Injective E_R := Function.LeftInverse.injective hL0
    refine ⟨W, L_R, ?_, ?_, ?_⟩
    · rw [LinearMap.finrank_range_of_inj hEinj]
      simp
    · rintro x ⟨v, rfl⟩ hx
      have hv : v = 0 := (hL0 v).symm.trans hx
      simp [hv]
    · rintro x ⟨v, rfl⟩ c hc
      exact (hLE c hc v).trans (hL0 v).symm

end D13Control

