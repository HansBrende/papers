+import TransposeFollowup.TwoStageHelper
+import TransposeFollowup.EntropyFibers
+
+/-! The two-stage toll charges actual helper entropy under the uniform
+correct input distribution. This strengthens charging log of the helper range,
+including when the ambient helper type is infinite. -/
+set_option autoImplicit false
+
+namespace TransposeFollowup.TwoStageHelper
+open Classical
+open scoped BigOperators
+variable {n b : Nat} {H : Type*} (T : TwoStageHelper n b H)
+
+noncomputable def attainedHelper (F : Finset (FiniteMatrix n b))
+    (x : F) : F.image T.helper :=
+  ⟨T.helper x.val, Finset.mem_image.mpr ⟨x.val, x.property, rfl⟩⟩
+
+theorem helper_entropy_deficit_bound (F : Finset (FiniteMatrix n b)) [Nonempty F]
+    (hc : T.CorrectOn F) (r : Nat) (hr : r ≤ n) :
+    (n * n * b : Nat) - Real.log (F.card : Real) / Real.log 2 +
+      observationEntropy (uniformWeight F) (T.attainedHelper F) / Real.log 2 ≥
+        (b * r * (n-r) : Nat) := by
+  classical
+  let c := (n-r)*n*b + r*r*b
+  let f := T.attainedHelper F
+  have hfiber (z : F.image T.helper) : fiberCard f z ≤ 2^c := by
+    calc
+      _ ≤ (F.filter (fun x => T.helper x = z.val)).card := by
+        unfold fiberCard
+        apply Finset.card_le_card_of_injOn Subtype.val
+        · intro x hx
+          simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_univ, true_and] at hx
+          have he := congrArg Subtype.val hx
+          exact Finset.mem_filter.mpr ⟨x.property, he⟩
+        · intro x hx y hy hxy
+          exact Subtype.ext hxy
+      _ ≤ 2^c := by
+        apply (T.branch z.val).correct_family_card _ _ r hr
+        intro x hx
+        obtain ⟨hx, he⟩ := Finset.mem_filter.mp hx
+        simpa only [apply, he] using hc x hx
+  let p := pushforward (uniformWeight F) f
+  have hp (z : F.image T.helper) : 0 ≤ p z :=
+    pushforward_nonneg _ (uniformWeight_nonneg F) f z
+  have hp1 : ∑ z, p z = 1 := by
+    dsimp only [p]
+    rw [sum_pushforward, sum_uniformWeight]
+  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
+  have hlog (z : F.image T.helper) :
+      Real.log (fiberCard f z : Real) ≤ (c : Real) * Real.log 2 := by
+    by_cases hz : fiberCard f z = 0
+    · simp only [hz, Nat.cast_zero, Real.log_zero]
+      exact mul_nonneg (Nat.cast_nonneg _) hlog2.le
+    · have hzpos : 0 < (fiberCard f z : Real) := by
+        exact_mod_cast Nat.pos_of_ne_zero hz
+      have hcast : (fiberCard f z : Real) ≤ (2 : Real)^c := by
+        exact_mod_cast hfiber z
+      calc
+        _ ≤ Real.log ((2 : Real)^c) := Real.log_le_log hzpos hcast
+        _ = _ := Real.log_pow 2 c
+  have hsum : (∑ z, p z * Real.log (fiberCard f z : Real)) ≤
+      (c : Real) * Real.log 2 := by
+    calc
+      _ ≤ ∑ z, p z * ((c : Real) * Real.log 2) := by
+        apply Finset.sum_le_sum
+        intro z hz
+        exact mul_le_mul_of_nonneg_left (hlog z) (hp z)
+      _ = _ := by rw [← Finset.sum_mul, hp1, one_mul]
+  have hmean := mean_log_fiberCard f
+  change (∑ z, p z * Real.log (fiberCard f z : Real)) =
+    Real.log (Fintype.card F : Real) - observationEntropy (uniformWeight F) f at hmean
+  rw [hmean] at hsum
+  simp only [Fintype.card_coe] at hsum
+  have hexp : c + b*r*(n-r) = n*n*b := by
+    dsimp [c]
+    have hn := Nat.sub_add_cancel hr
+    calc
+      _ = (n-r)*n*b + r*((n-r)+r)*b := by ring
+      _ = (n-r)*n*b + r*n*b := by rw [hn]
+      _ = ((n-r)+r)*n*b := by ring
