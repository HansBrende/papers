/-! ### 1. Affine `k`-Cube Common-Message Growth -/

section CubeGrowth

variable {F A Z : Type*} [Field F] [AddCommGroup A] [Module F A]
  [AddCommGroup Z] [Module F Z]

/-- Iterated subspace span generated by an ordered `k`-tuple of linear endomorphisms on `W`. -/
private def cubeOrbitSpan : {k : ℕ} → (Fin k → (A →ₗ[F] A)) → Submodule F A → Submodule F A
  | 0, _, W => W
  | k + 1, R, W =>
      let S := cubeOrbitSpan (fun i : Fin k => R i.castSucc) W
      S ⊔ S.map (R (Fin.last k))

private theorem le_cubeOrbitSpan :
    ∀ {k : ℕ} (R : Fin k → (A →ₗ[F] A)) (W : Submodule F A), W ≤ cubeOrbitSpan R W
  | 0, _, _ => le_rfl
  | k + 1, R, W =>
      le_trans (le_cubeOrbitSpan (fun i : Fin k => R i.castSucc) W) le_sup_left

private theorem orderedCubeMap_snoc_false {k : ℕ}
    (R : Fin (k + 1) → (A →ₗ[F] A)) (ε : Fin k → Bool) :
    orderedCubeMap R (Fin.snoc ε false) =
      orderedCubeMap (fun i : Fin k => R i.castSucc) ε := by
  simp [orderedCubeMap]

private theorem orderedCubeMap_snoc_true {k : ℕ}
    (R : Fin (k + 1) → (A →ₗ[F] A)) (ε : Fin k → Bool) :
    orderedCubeMap R (Fin.snoc ε true) =
      (R (Fin.last k)).comp (orderedCubeMap (fun i : Fin k => R i.castSucc) ε) := by
  simp [orderedCubeMap]

private theorem cubeOrbitSpan_le_ker :
    ∀ {k : ℕ} (R : Fin k → (A →ₗ[F] A)) (W : Submodule F A)
      {Z' : Type*} [AddCommGroup Z'] [Module F Z'] (M : A →ₗ[F] Z'),
      (∀ x ∈ W, ∀ ε : Fin k → Bool, M (orderedCubeMap R ε x) = 0) →
      cubeOrbitSpan R W ≤ LinearMap.ker M
  | 0, R, W, _, _, _, M, hM => by
      intro x hx
      simpa [orderedCubeMap] using hM x hx Fin.elim0
  | k + 1, R, W, _, _, _, M, hM => by
      apply sup_le
      · apply cubeOrbitSpan_le_ker (fun i : Fin k => R i.castSucc) W M
        intro x hx ε
        have h := hM x hx (Fin.snoc ε false)
        rwa [orderedCubeMap_snoc_false] at h
      · rintro _ ⟨y, hy, rfl⟩
        have hsub := cubeOrbitSpan_le_ker (fun i : Fin k => R i.castSucc) W
          (M.comp (R (Fin.last k))) ?_ hy
        · exact hsub
        · intro x hx ε
          have h := hM x hx (Fin.snoc ε true)
          rwa [orderedCubeMap_snoc_true] at h

private theorem finrank_cubeOrbitSpan_growth [FiniteDimensional F A] :
    ∀ (k : ℕ) (R : Fin k → (A →ₗ[F] A)) (W : Submodule F A) (L : A →ₗ[F] Z),
      (∀ x ∈ W, L x = 0 → x = 0) →
      (∀ x ∈ W, ∀ ε : Fin k → Bool, L (orderedCubeMap R ε x) = L x) →
      (k + 1) * finrank F W ≤
        finrank F (cubeOrbitSpan R W) +
          ∑ t : Fin k, finrank F (LinearMap.ker (R t - LinearMap.id))
  | 0, R, W, L, _, _ => by
      simp only [cubeOrbitSpan, zero_add, one_mul, Finset.univ_eq_empty, Finset.sum_empty, add_zero]
      exact le_rfl
  | k + 1, R, W, L, hinj, hmsg => by
      let Rinit : Fin k → (A →ₗ[F] A) := fun i => R i.castSucc
      let S := cubeOrbitSpan Rinit W
      let Rlast := R (Fin.last k)
      let B : Submodule F A := S ⊔ S.map Rlast
      let P : A →ₗ[F] A := Rlast - LinearMap.id
      have ih : (k + 1) * finrank F W ≤
          finrank F S + ∑ t : Fin k, finrank F (LinearMap.ker (Rinit t - LinearMap.id)) :=
        finrank_cubeOrbitSpan_growth k Rinit W L hinj (by
          intro x hx ε
          have h := hmsg x hx (Fin.snoc ε false)
          rwa [orderedCubeMap_snoc_false] at h)
      have hstep : finrank F W + finrank F S ≤ finrank F B + finrank F (LinearMap.ker P) := by
        apply SharedDecoders.finrank_growth W S B P L
        · exact le_trans (le_cubeOrbitSpan Rinit W) le_sup_left
        · rintro _ ⟨u, hu, rfl⟩
          exact B.sub_mem (Submodule.mem_sup_right ⟨u, hu, rfl⟩) (Submodule.mem_sup_left hu)
        · rintro _ ⟨u, hu, rfl⟩
          have hker : S ≤ LinearMap.ker (L.comp P) := by
            apply cubeOrbitSpan_le_ker Rinit W (L.comp P)
            intro x hx ε
            have h1 := hmsg x hx (Fin.snoc ε true)
            have h0 := hmsg x hx (Fin.snoc ε false)
            rw [orderedCubeMap_snoc_true] at h1
            rw [orderedCubeMap_snoc_false] at h0
            simp only [LinearMap.comp_apply, P, LinearMap.sub_apply, LinearMap.id_apply, map_sub]
            exact sub_eq_zero.mpr (h1.trans h0.symm)
          exact hker hu
        · exact hinj
      rw [Fin.sum_univ_castSucc]
      change (k + 2) * finrank F W ≤
        finrank F B +
          (∑ i : Fin k, finrank F (LinearMap.ker (Rinit i - LinearMap.id)) +
            finrank F (LinearMap.ker P))
      have hmul : (k + 2) * finrank F W = (k + 1) * finrank F W + finrank F W := by ring
      omega

theorem lemma_AffineCubeCommonMessageGrowth : Lemma_AffineCubeCommonMessageGrowthSpec := by
  intro F A Z _ _ _ _ _ _ k R W L hinj hmsg
  have hg := finrank_cubeOrbitSpan_growth k R W L hinj hmsg
  have ha := (cubeOrbitSpan R W).finrank_le
  omega

end CubeGrowth

